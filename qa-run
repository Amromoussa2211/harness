# ── Stage 7: QA Specification ──────────────────────────────────────────────

def _execute_specification(stage_name, story_id, story_source, project_config,
                           project_name, project_dir, stage_status):
    try:
        grill_text = load_stage_artifact(story_id, "grill/output.md")
        analysis_text = load_stage_artifact(story_id, "analysis/output.md")
        risk_text = load_stage_artifact(story_id, "risk/output.md")
        arch_text = load_stage_artifact(story_id, "architecture/output.md")
        discovery_text = load_stage_artifact(story_id, "discovery/output.md")
        intake_text = load_stage_artifact(story_id, "story-intake.md")
    except FileNotFoundError as e:
        return "blocked", [f"Missing input: {e}"]

    # Parse all inputs
    grill_sections = parse_markdown_sections(grill_text)
    analysis_sections = parse_markdown_sections(analysis_text)
    intake_sections = parse_markdown_sections(intake_text)

    # Extract story identity
    story_title = intake_sections.get("Story Title", intake_sections.get("Title", story_id))
    user_story = intake_sections.get("User Story", "").strip()
    ac_text = intake_sections.get("Acceptance Criteria", "").strip()
    business_rules_text = intake_sections.get("Business Rules", "").strip()
    NL = "\n"

    # Parse acceptance criteria into items
    ac_items = []
    if ac_text:
        for line in ac_text.splitlines():
            if line.startswith("### "):
                current = {"heading": line[4:].strip(), "body": []}
                ac_items.append(current)
            elif ac_items and current["heading"]:
                ac_items[-1]["body"].append(line)
            elif not ac_items:
                # ACs might be at top level without ### prefix
                if line.strip() and not line.startswith("#"):
                    ac_items.append({"heading": line.strip(), "body": []})

    # Helper: extract list items
    def extract_items(section_text):
        if not section_text:
            return []
        items = []
        for line in section_text.splitlines():
            s = line.strip()
            if s.startswith("- **") or s.startswith("- "):
                items.append(s)
        return items

    # Project adapter
    app = project_config.get("application", {})
    api = project_config.get("api", {})
    db = project_config.get("database", {})
    env = project_config.get("environments", {})
    safety = project_config.get("safety", {})
    env_enabled = any(env.get(k) for k in ("dev", "staging", "production"))

    S = []

    # ── Header ──
    S.extend([
        f"# QA Specification — {story_id}",
        "",
        f"**Project:** {project_name}",
        "**Source inputs:** story-intake.md, grill/output.md, analysis/output.md, risk/output.md, architecture/output.md, discovery/output.md, project.yaml",
        f"**Specification timestamp:** {now_iso()}",
        "",
        "---",
        "",
        "## 1. Requirement under Specification",
        "",
    ])

    if user_story:
        S.append(user_story)
    else:
        S.append(f"(No user story found in intake for {story_id})")
    S.extend([f"Story: {story_id}", ""])

    # ── 2. Functional Coverage (dynamic from ACs) ──
    S.extend(["## 2. Functional Coverage", ""])

    if ac_items:
        for ac in ac_items:
            heading = ac["heading"]
            body = NL.join(ac["body"]).strip()
            S.extend([
                f"### {heading}",
                "",
                "| Aspect | Coverage | Status |",
                "|--------|----------|--------|",
                "| Precondition | " + ("Covered by AC statement" if "Given" in body else "Not specified in AC — may need test data setup"),
                "| Action | " + ("Covered by AC statement" if "When" in body else "Not specified in AC"),
                "| Expected outcome | " + ("Covered by AC statement" if "Then" in body else "Not specified in AC — expected outcome missing"),
            ])

            # Add dynamic blockage notes
            if "error" in body.lower() or "validation" in body.lower():
                if "message" in body.lower():
                    S.append("| Error message text | Not defined in AC | Blocked — error message text not defined |")
            if any(w in body.lower() for w in ["redirect", "navigate", "go to", "open", "Dashboard"]):
                S.append("| Destination/redirect target | Not defined in AC | Blocked — destination not defined |")
            if "registered" in body.lower() or "exists" in body.lower() or "pre-existing" in body.lower():
                S.append("| Precondition data setup | Test data setup required | Blocked — no credentials or creation mechanism available |")
            S.append("")
    else:
        S.extend(["_(No acceptance criteria found in intake. Functional coverage cannot be defined.)_", ""])

    # ── 3. Negative Coverage ──
    S.extend(["## 3. Negative Coverage", ""])

    grill_negative = grill_sections.get("Negative Scenarios", "")
    neg_items = extract_items(grill_negative)

    if neg_items:
        S.extend(["| Scenario | Expected Outcome | Status |", "|----------|-----------------|--------|"])

        for item in neg_items:
            # Parse item: "- **Scenario Name:** description (status)"
            name = item.split(":**", 1)[0].replace("- **", "").strip()
            rest = item.split(":**", 1)[1] if ":**" in item else item

            expected = "(see scenario description)"
            status = "Not specified"

            if "Expected:" in rest:
                expected = rest.split("Expected:", 1)[1].strip()
                if ".**" in expected:
                    expected = expected.split(".**")[0] + ".**"
                if "**Not specified" in expected or "**Not specified." in expected:
                    expected = "Not specified"
                    status = "Not specified"

            if "**Confirmed by acceptance criteria**" in item:
                status = "Confirmed by acceptance criteria"
            elif "**Not explicitly specified**" in item:
                status = "Not explicitly specified"

            S.append(f"| {name} | {expected} | {status} |")
        S.append("")
    else:
        S.append("_(No negative scenarios identified in grill output.)_")
        S.append("")

    # ── 4. Boundary Coverage ──
    S.extend(["## 4. Boundary Coverage", ""])

    boundaries = []

    # From business rules
    if business_rules_text:
        for rule in business_rules_text.splitlines():
            r = rule.strip()
            if r.startswith("-") and r.strip("- ").strip():
                rule_text = r.strip("- ").strip()
                if "expire" in rule_text.lower():
                    boundaries.append("| Time-based expiry boundary | Behavior at exact expiry moment | Not specified |")
                if "once" in rule_text.lower() or "only be used once" in rule_text.lower():
                    boundaries.append("| Re-use/duplicate attempt boundary | Behavior on re-use | Not specified |")
                if "password" in rule_text.lower() or "policy" in rule_text.lower():
                    boundaries.append("| Password policy boundary | Behavior at policy limits | Not specified |")

    # From AC analysis
    for ac in ac_items:
        body_lower = NL.join(ac["body"]).lower()
        if "email" in body_lower:
            boundaries.append("| Email field empty | Email validation error | Not specified in AC |")
            boundaries.append("| Email field very long input | Handling behavior | Not specified |")
        if "password" in body_lower:
            boundaries.append("| Password field empty | Password validation error | Not specified in AC |")
            boundaries.append("| Password field very long input | Handling behavior | Not specified |")
        if "code" in body_lower:
            boundaries.append("| Verification code format | Code format, length, charset | Not specified |")
            boundaries.append("| Verification code expiry | Expiry duration and behavior | Not specified |")
        if "amount" in body_lower or "price" in body_lower or "quantity" in body_lower:
            boundaries.append("| Numeric boundary (0, max, min) | Handling at limits | Not specified |")

    # Generic boundaries if none derived
    if not boundaries:
        boundaries = [
            "| Empty or null inputs | Validation error or rejection | Not specified |",
            "| Very large inputs | Handling behavior | Not specified |",
            "| Repeated operations | Idempotency behavior | Not specified |",
        ]

    S.extend(["| Boundary | Spec | Status |", "|----------|------|--------|"])
    S.extend(boundaries)
    S.append("")

    # ── 5. Integration Coverage ──
    S.extend(["## 5. Integration Coverage", ""])

    integration_points = []

    if api.get("rest"):
        integration_points.append("| REST API | API endpoint, request/response contract, authentication | Blocked — endpoints unknown |")
    if api.get("graphql"):
        integration_points.append("| GraphQL API | Operation, query/mutation, response types | Blocked — schema unknown |")
    if api.get("webhooks"):
        integration_points.append("| Webhooks | Event types, payload structure, endpoint URL | Blocked — webhook details unknown |")

    if app.get("web") and any("web" in nl.lower() or "ui" in nl.lower() or "page" in nl.lower() or "form" in nl.lower() for nl in [user_story, ac_text]):
        integration_points.append("| Web UI | Page URLs, UI interaction flow, browser state | Blocked — URLs and UI flow not specified |")

    if db.get("enabled"):
        integration_points.append("| Database | Schema, data access, transactions | Blocked — schema not specified |")
    elif any("data" in ip.lower() or "storage" in ip.lower() or "credential" in ip.lower() for ip in integration_points):
        integration_points.append("| Data storage | Persistent storage mechanism | Blocked — storage mechanism not specified |")

    if not env_enabled:
        integration_points.append("| Test environment | Dev or staging environment | Blocked — no environment enabled |")

    if integration_points:
        S.extend(["| Integration point | Spec | Status |", "|-------------------|------|--------|"])
        S.extend(integration_points)
    else:
        S.append("_(No integration points identified from project adapter.)_")
    S.append("")

    # ── 6. Validation Expectations ──
    S.extend(["## 6. Validation Expectations", ""])

    validations = []

    if ac_items:
        for ac in ac_items:
            heading = ac["heading"]
            body = NL.join(ac["body"]).strip()

            # Determine validation type
            if any(w in body.lower() for w in ["clicks", "enters", "type", "fill", "form", "field", "button", "page", "navigate", "redirect", "display"]):
                vtype = "UI validation"
            elif any(w in body.lower() for w in ["api", "endpoint", "request", "response", "status code", "http", "post", "get"]):
                vtype = "API validation"
            elif any(w in body.lower() for w in ["state", "updated", "created", "deleted", "stored", "saved"]):
                vtype = "State validation"
            else:
                vtype = "Behavior validation"

            # Extract expected
            expected = ""
            if "Then" in body:
                expected = body.split("Then", 1)[1].strip()
                if "." in expected:
                    expected = expected.split(".")[0].strip()

            status = "Defined in AC" if expected else "Blocked — expected outcome not fully defined"
            validations.append(f"| {heading} | {vtype} | {expected or '(see AC statement)'} | {status} |")

    if validations:
        S.extend(["| Validation | Type | Expected behavior | Status |", "|------------|------|-------------------|--------|"])
        S.extend(validations)
    else:
        S.append("_(No validation expectations can be defined — no acceptance criteria found.)_")
    S.append("")

    # ── 7. Required Test Data ──
    S.extend(["## 7. Required Test Data", ""])

    test_data = []

    if ac_items:
        needs_registered = any("registered" in NL.join(ac["body"]).lower() or "exists" in NL.join(ac["body"]).lower() or "pre-existing" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_valid = any("valid" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_invalid = any("invalid" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_code = any("code" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_email = any("email" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_password = any("password" in NL.join(ac["body"]).lower() for ac in ac_items)

        if needs_registered:
            test_data.append("- **Precondition entities:** Pre-existing entities required by the ACs (e.g., registered user, existing order). Blocked — creation mechanism not specified.")
        if needs_valid:
            test_data.append("- **Valid input samples:** Valid inputs required to test positive scenarios. Blocked — valid input values not specified.")
        if needs_invalid:
            test_data.append("- **Invalid input samples:** Invalid inputs required to test negative scenarios. Blocked — invalid input values not specified.")
        if needs_code:
            test_data.append("- **Verification codes:** Valid and expired codes for testing. Blocked — code format and values not specified.")
        if needs_email:
            test_data.append("- **Email addresses:** Valid and invalid email addresses for testing. Blocked — specific email values not specified.")
        if needs_password:
            test_data.append("- **Password samples:** Valid and invalid passwords for testing. Blocked — password values and policy not specified.")

    if not test_data:
        test_data.append("- **Test data requirements:** Cannot be determined — no acceptance criteria or business rules specify data requirements.")

    S.extend(test_data)
    S.append("")

    # ── 8. Required Environment Dependencies ──
    S.extend(["## 8. Required Environment Dependencies", ""])

    env_deps = []
    if not env_enabled:
        env_deps.append("- **Test environment:** At least one environment (dev or staging) must be enabled in the project adapter.")
    else:
        env_deps.append(f"- **Test environment:** {', '.join(k for k, v in env.items() if v)} environment(s) enabled in project adapter.")

    if app.get("web"):
        env_deps.append("- **Application URL:** Base URL for the web application must be known.")
    if app.get("api"):
        env_deps.append("- **API base URL:** Base URL for the API must be known.")

    if safety.get("production_execution"):
        env_deps.append("- **Production safety:** Production execution is enabled — explicit authorization required for any production operation.")

    if not env_deps:
        env_deps.append("- **Environment dependencies:** Cannot be determined from project adapter.")

    S.extend(env_deps)
    S.append("")

    # ── 9. Confirmed Requirements ──
    S.extend(["## 9. Confirmed Requirements", ""])

    confirmed = []
    if user_story:
        confirmed.append(f"- {user_story}")
    if ac_items:
        for ac in ac_items:
            confirmed.append(f"- {ac['heading']}: {NL.join(ac['body']).strip()}")

    S.extend(confirmed if confirmed else ["- No confirmed requirements found in intake."])
    S.append("")

    # ── 10. Assumptions ──
    S.extend([
        "## 10. Assumptions",
        "",
        "- The feature is tested at the level appropriate to its interface (UI, API, or both) as determined by the project adapter and clarification.",
        "- Validation errors are displayed to the user in some observable form.",
        "- The project adapter is accurate and current.",
        "",
    ])

    # ── 11. Unknowns ──
    S.extend(["## 11. Unknowns", ""])

    unknowns = []
    if not ac_items:
        unknowns.append("- Acceptance criteria — not found in intake")
    if not env_enabled:
        unknowns.append("- Test environment — not enabled in project adapter")
    if app.get("web") and not any("url" in u.lower() for u in unknowns):
        unknowns.append("- Application URL / base URL")
    if api.get("rest") and not any("endpoint" in u.lower() for u in unknowns):
        unknowns.append("- API endpoints and contracts")

    # Add unknowns from grill
    grill_unknowns_text = grill_sections.get("Unknowns", "")
    if grill_unknowns_text:
        for line in grill_unknowns_text.splitlines():
            if line.strip().startswith("- "):
                unknowns.append(line.strip()[2:])

    S.extend(unknowns if unknowns else ["- No significant unknowns identified."])
    S.append("")

    # ── 12. Items Blocked Pending Clarification ──
    S.extend(["## 12. Items Blocked Pending Clarification", "", "| Item | Blocked by |", "|------|------------|"])

    blocked = []

    if any("Ambiguity" in line for line in extract_items(grill_sections.get("Ambiguities", ""))):
        blocked.append("| Ambiguities in requirement | Must be clarified before specification |")

    if not env_enabled:
        blocked.append("| Test environment targeting | No environments enabled in project adapter |")

    if api.get("rest") and not any("endpoint" in b.lower() for b in blocked):
        blocked.append("| API integration tests | API endpoints not specified |")

    if not blocked:
        blocked.append("| No items blocked | — |")

    S.extend(blocked)
    S.append("")

    # Footer
    S.extend([
        "---",
        "",
        f"*QA Specification performed by qa-run runtime. Specification is grounded in story-intake.md, grill/output.md, analysis/output.md, risk/output.md, architecture/output.md, discovery/output.md, and project.yaml only. No expected outcomes were invented. Blocked items are clearly identified.*",
    ])

    content = NL.join(S)
    art = write_stage_artifact(story_id, "specification/output.md", content)
    return "completed", [art]


