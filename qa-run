def _execute_ai_analysis(stage_name, story_id, story_source, project_config,
                          project_name, project_dir, stage_status):
    """AI-enhanced analysis stage.

    Runs the Analyst agent to produce a structured analysis of the story.
    Falls back to the deterministic analysis if AI is unavailable.
    """
    if not AI_BRAIN_AVAILABLE:
        return _execute_analysis(stage_name, story_id, story_source, project_config,
                                 project_name, project_dir, stage_status)

    # Read the story text
    story_path = Path(story_source) if Path(story_source).is_absolute() else ROOT / story_source
    story_text = story_path.read_text(errors="replace") if story_path.exists() else ""

    if not story_text.strip():
        return "failed", ["Story file is empty"]

    # Build AI config
    ai_cfg = build_ai_config(project_config, story_id=story_id,
                             project_name=project_name)

    # Initialize AI engine
    shared_state_dir = ROOT / "shared-state" / story_id
    shared_state_dir.mkdir(parents=True, exist_ok=True)

    engine = AIEngine(
        shared_state_base=shared_state_dir,
        project_dir=Path(project_dir) if project_dir else Path(),
        mode="ai",
        config=ai_cfg,
    )
    engine.set_run_metadata(story_id, project_name, config_source="env")

    # Run the Analyst agent
    result = engine.run_analyst(story_text, project_config)

    # Save AI analysis artifact
    art_dir = shared_state_dir / "ai-analysis"
    art_dir.mkdir(parents=True, exist_ok=True)
    art_path = art_dir / "ai-analysis.md"

    # Build markdown from the structured output
    output = result.output if result.status == "success" else {}
    execution_type = "SIMULATED" if ai_cfg.provider == "noop" else "REAL_LLM"
    md_lines = [
        f"# AI Analysis — {story_id}",
        "",
        f"**AI Mode:** enabled | **Provider:** {ai_cfg.provider} | **Model:** {ai_cfg.model}",
        f"**Execution:** {execution_type}",
        f"**Prompt Version:** {ai_cfg.prompt_version}",
        f"**Run ID:** {engine.run_id}",
        f"**Story ID:** {story_id}",
        f"**Project:** {project_name}",
        "",
        "---",
        "",
    ]

    if result.status == "success":
        md_lines.append("## Summary")
        md_lines.append("")
        md_lines.append(output.get("summary", "No summary available."))
        md_lines.append("")

        if output.get("actors"):
            md_lines.append("## Actors")
            md_lines.append("")
            for actor in output["actors"]:
                md_lines.append(f"- {actor}")
            md_lines.append("")

        if output.get("inputs"):
            md_lines.append("## Inputs")
            md_lines.append("")
            for inp in output["inputs"]:
                md_lines.append(f"- {inp}")
            md_lines.append("")

        if output.get("outputs"):
            md_lines.append("## Outputs")
            md_lines.append("")
            for out in output["outputs"]:
                md_lines.append(f"- {out}")
            md_lines.append("")

        if output.get("acceptance_criteria"):
            md_lines.append("## Acceptance Criteria")
            md_lines.append("")
            for ac in output["acceptance_criteria"]:
                md_lines.append(f"- **{ac.get('id', 'N/A')}**: {ac.get('text', 'N/A')} ({ac.get('type', 'N/A')})")
            md_lines.append("")

        if output.get("ambiguities"):
            md_lines.append("## Ambiguities Detected")
            md_lines.append("")
            for amb in output["ambiguities"]:
                md_lines.append(f"- **{amb.get('issue', 'N/A')}** (confidence: {amb.get('confidence', 'N/A')}) — {amb.get('impact', 'N/A')}")
            md_lines.append("")

        if output.get("missing_requirements"):
            md_lines.append("## Missing Requirements")
            md_lines.append("")
            for mr in output["missing_requirements"]:
                md_lines.append(f"- **{mr.get('requirement', 'N/A')}** — {mr.get('why_needed', 'N/A')}")
            md_lines.append("")

        if output.get("dependencies"):
            md_lines.append("## Dependencies")
            md_lines.append("")
            for dep in output["dependencies"]:
                md_lines.append(f"- **{dep.get('dependency', 'N/A')}** ({dep.get('type', 'N/A')})")
            md_lines.append("")

        if output.get("assumptions"):
            md_lines.append("## Assumptions")
            md_lines.append("")
            for asm in output["assumptions"]:
                md_lines.append(f"- **{asm.get('assumption', 'N/A')}** — {asm.get('justification', 'N/A')} (risk: {asm.get('risk', 'N/A')})")
            md_lines.append("")

        if output.get("unknowns"):
            md_lines.append("## Unknowns")
            md_lines.append("")
            for unk in output["unknowns"]:
                md_lines.append(f"- **{unk.get('unknown', 'N/A')}** — {unk.get('impact', 'N/A')}")
            md_lines.append("")

        if output.get("questions"):
            md_lines.append("## Questions for Clarification")
            md_lines.append("")
            for q in output["questions"]:
                md_lines.append(f"- **{q.get('question', 'N/A')}** (priority: {q.get('priority', 'N/A')})")
            md_lines.append("")

        md_lines.append(f"**Confidence:** {output.get('confidence', 'N/A')}")
    else:
        md_lines.append(f"## AI Analysis Failed")
        md_lines.append("")
        md_lines.append(f"**Error:** {result.error}")
        md_lines.append(f"**Error Type:** {result.error_type}")
        md_lines.append("")
        md_lines.append("Falling back to deterministic analysis.")
        md_lines.append("")

    # Always run deterministic analysis too for comparison
    det_status, det_arts = _execute_analysis(stage_name, story_id, story_source,
                                              project_config, project_name, project_dir,
                                              stage_status)
    det_art = det_arts[0] if det_arts else ""

    md_lines.append("---")
    md_lines.append("")
    md_lines.append("## Deterministic Analysis (for comparison)")
    md_lines.append("")
    if det_art and Path(det_art).exists():
        md_lines.append(Path(det_art).read_text(errors="replace"))
    else:
        md_lines.append("*No deterministic analysis artifact available.*")
    md_lines.append("")

    md_lines.append("---")
    md_lines.append("")
    md_lines.append(f"*AI analysis generated by QA Agent Harness AI Brain. Provider: {ai_cfg.provider}, Model: {ai_cfg.model}, Prompt Version: {ai_cfg.prompt_version}, Run ID: {engine.run_id}*")

    content = "\n".join(md_lines)
    art_path.write_text(content, encoding="utf-8")

    # Save AI engine result
    engine_result_path = art_dir / "engine-result.json"
    engine_result_path.write_text(json.dumps({
        "run_id": engine.run_id,
        "story_id": story_id,
        "project_name": project_name,
        "mode": "ai",
        "provider": ai_cfg.provider,
        "model": ai_cfg.model,
        "prompt_version": ai_cfg.prompt_version,
        "agent_name": "analyst",
        "agent_role": "QA Analyst",
        "status": result.status,
        "latency_ms": round(result.latency_ms, 2),
        "prompt_tokens": result.prompt_tokens,
        "completion_tokens": result.completion_tokens,
        "cost_usd": round(result.cost_usd, 6),
        "error": result.error,
        "error_type": result.error_type,
        "output_keys": list(result.output.keys()) if result.output else [],
    }, indent=2))

    return "completed", [str(art_path), str(engine_result_path)]


