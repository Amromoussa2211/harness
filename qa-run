        fa_issue_count += 1
        issue_id = f"FA-{fa_issue_count:03d}"

        spec_classification = "Automation failure"
        spec_root_cause = "Confirmed"
        spec_confidence = "High"

        if "BASE_URL_UNAVAILABLE" in spec_blocker:
