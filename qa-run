# ── Main ────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(
        description="QA Agent Harness — drive a QA story through the 14-stage workflow."
    )
    parser.add_argument(
        "story_path",
        help="projects/<project>/stories/<story-id>.md",
    )
    parser.add_argument(
        "--full-run",
        action="store_true",
        help="Execute all pending stages until completion (final-report, failed, or persistent blocked)",
    )
    parser.add_argument(
        "--mode",
        choices=["deterministic", "ai"],
        default="deterministic",
        help="Execution mode: deterministic (default) or ai (AI-enhanced reasoning)",
    )
    args = parser.parse_args()

    raw_path = args.story_path
    story_path, info = validate_story_path(raw_path)

    project_config = load_project_adapter(info["project_name"])
    stage_order = load_workflow_stages()
    story_id = info["story_id"]

    # Detect existing run or initialize
    existing = load_stage_status(story_id)
    if existing is None:
        # New run — build fresh status
        status = build_fresh_status(stage_order, story_id)
        status["project"] = info["project_name"]
        status["story"] = info["story_path"]
        save_stage_status(story_id, status)

        # Execute story-intake immediately
        intake_status, intake_arts = execute_stage(
            "story-intake", story_id, info["story_path"],
            project_config, info["project_name"],
            info["project_dir"], status,
        )
        status["stages"]["story-intake"]["status"] = intake_status
        status["stages"]["story-intake"]["completed_at"] = now_iso()
        status["stages"]["story-intake"]["artifacts"] = intake_arts
        status["overall_status"] = calculate_overall_status(status["stages"])
        status["project"] = info["project_name"]
        status["story"] = info["story_path"]
        save_stage_status(story_id, status)

        print(f"Story Intake: {intake_status}")
        for a in intake_arts:
            print(f"  Artifact: {a}")
        print(f"Overall: {status['overall_status']}")
        print(f"Next stage: {find_first_pending_stage(stage_order, status['stages'])}")

        # If --full-run, continue to the loop below. Otherwise, legacy one-stage return.
        if not args.full_run:
            return
    else:
        # Resume existing run
        status = existing
        status["project"] = info["project_name"]
        status["story"] = info["story_path"]

        # Validate project adapter still exists
        if not Path(info["adapter_path"]).exists():
            print(f"Error: project adapter missing: {info['adapter_path']}", file=sys.stderr)
            status["overall_status"] = "blocked"
            save_stage_status(story_id, status)
            sys.exit(2)

    # ── Full-run loop (or single-stage for legacy mode) ──────────────────────
    blocked_retries: dict[str, int] = {}

    while True:
        if args.full_run:
            # Full-run mode: iterate through stage_order, attempting any non-completed stage.
            # Blocked stages are re-attempted (up to 2 consecutive blocked returns before stopping).
            next_stage = None
            for name in stage_order:
                st = status["stages"][name]["status"]
                if st == "completed" or st == "skipped":
                    continue
                next_stage = name
                break

            if next_stage is None:
                # All stages completed or skipped
                overall = calculate_overall_status(status["stages"])
                status["overall_status"] = overall
                save_stage_status(story_id, status)
                print(f"All stages completed or skipped. Overall: {overall}")
                if overall == "completed":
                    print(f"Final report: shared-state/{story_id}/final-report.md")
                break
        else:
            # Legacy mode: use find_first_pending_stage for one stage at a time.
            # Blocked-with-reason stages are skipped (treated as resolved).
            next_stage = find_first_pending_stage(stage_order, status["stages"])
            if next_stage is None:
                overall = calculate_overall_status(status["stages"])
                status["overall_status"] = overall
                save_stage_status(story_id, status)
                print(f"All stages completed or skipped. Overall: {overall}")
                if overall == "completed":
                    print(f"Final report: shared-state/{story_id}/final-report.md")
                break

        current_status = status["stages"][next_stage]["status"]

        if current_status == "in_progress":
            print(f"Stage '{next_stage}' is already in progress. Resume or restart required.", file=sys.stderr)
            status["overall_status"] = "running"
            save_stage_status(story_id, status)
            sys.exit(3)

        if current_status == "failed":
            reason = status["stages"][next_stage].get("failed_reason", "No reason recorded")
            print(f"Stage '{next_stage}' failed: {reason}", file=sys.stderr)
            status["overall_status"] = "failed"
            save_stage_status(story_id, status)
            sys.exit(3)

        if current_status == "blocked":
            reason = status["stages"][next_stage].get("blocked_reason", "No reason recorded")
            print(f"Stage '{next_stage}' is blocked: {reason}", file=sys.stderr)
            # Will be attempted — counter increment happens after execution result
        else:
            # Not blocked — reset retry counter for this stage
            blocked_retries.pop(next_stage, None)

        # Mark stage as in_progress and persist
        stage_status = status["stages"][next_stage]
        stage_status["status"] = "in_progress"
        stage_status["started_at"] = now_iso()
        save_stage_status(story_id, status)

        # Execute the stage
        exec_status, artifacts = execute_stage(
            next_stage, story_id, info["story_path"],
            project_config, info["project_name"],
            info["project_dir"], stage_status,
        )

        # If in AI mode, also run the corresponding AI-enhanced stage
        if args.mode == "ai" and AI_BRAIN_AVAILABLE:
            ai_stage_map = {
                "analysis": "ai-analysis",
                "grill": "ai-grill",
                "risk": "ai-risk",
                "architecture": "ai-architecture",
                "specification": "ai-specification",
                "test-design": "ai-test-design",
                "failure-analysis": "ai-failure-analysis",
                "review": "ai-review",
            }
            ai_stage = ai_stage_map.get(next_stage)
            if ai_stage and status["stages"][ai_stage]["status"] in ("pending", "completed"):
                # Run AI stage asynchronously (don't block on failure)
                try:
                    ai_status, ai_arts = execute_stage(
                        ai_stage, story_id, info["story_path"],
                        project_config, info["project_name"],
                        info["project_dir"], status["stages"][ai_stage],
                    )
                    status["stages"][ai_stage]["status"] = ai_status
                    status["stages"][ai_stage]["completed_at"] = now_iso() if ai_status == "completed" else None
                    status["stages"][ai_stage]["artifacts"] = ai_arts
                    if ai_arts:
                        print(f"  AI-Artifact: {ai_arts[0]}")
                    print(f"  AI-{next_stage}: {ai_status}")
                except Exception as e:
                    print(f"  AI-{next_stage} error: {e}", file=sys.stderr)
                    status["stages"][ai_stage]["status"] = "failed"
                    status["stages"][ai_stage]["failed_reason"] = str(e)

        # Update stage status
        stage_status["status"] = exec_status
        stage_status["completed_at"] = now_iso() if exec_status == "completed" else None
        stage_status["artifacts"] = artifacts
        if exec_status == "blocked":
            stage_status["blocked_reason"] = artifacts[0] if artifacts else "Unknown reason"
            # Increment retry counter after execution returns blocked
            blocked_retries[next_stage] = blocked_retries.get(next_stage, 0) + 1
            if blocked_retries[next_stage] >= 2:
                print(f"WARNING: Stage '{next_stage}' has returned blocked {blocked_retries[next_stage]} times. Stopping full-run.", file=sys.stderr)
                status["overall_status"] = "blocked"
                save_stage_status(story_id, status)
                break
        elif exec_status == "failed":
            stage_status["failed_reason"] = artifacts[0] if artifacts else "Unknown reason"
        elif exec_status == "skipped":
            stage_status["skip_reason"] = artifacts[0] if artifacts else "Skipped"
            stage_status["completed_at"] = now_iso()
        else:
            # completed or other non-blocking status — reset retry counter
            blocked_retries.pop(next_stage, None)

        # Recalculate overall status and persist
        status["overall_status"] = calculate_overall_status(status["stages"])
        save_stage_status(story_id, status)

        # Print results
        print(f"---")
        print(f"Stage: {next_stage}")
        print(f"Status: {exec_status}")
        for a in artifacts:
            print(f"  Artifact: {a}")
        print(f"Overall: {status['overall_status']}")

        # Legacy mode: execute one stage and exit
        if not args.full_run:
            print(f"Next stage: {find_first_pending_stage(stage_order, status['stages'])}")
            break


if __name__ == "__main__":
    main()
