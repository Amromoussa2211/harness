def _enrich_discovery_with_adapter(discovery_lines, project_config, project_name, project_dir):
    """Enrich discovery output with target project adapter data when available."""
    if not ADAPTER_AVAILABLE:
        return
    try:
        adapter = create_adapter(project_config, project_name, project_dir)
    except Exception:
        return
    target = adapter.get_target_repository_path()
    if target is None:
        return
    capabilities = adapter.detect_capabilities()
    environments = adapter.discover_environments()
    test_data = adapter.discover_test_data()
    caps = capabilities
    lang = caps.get("language", "unknown")
    pm = caps.get("package_manager", "unknown")
    # Section 1: Technology Stack
    for i, line in enumerate(discovery_lines):
        if "Test automation framework:" in line and caps.get("existing_automation"):
            if caps.get("playwright"):
                discovery_lines[i] = f"- **Test automation framework:** {caps.get('framework_version') or 'Playwright'} (detected in target repository)"
            elif caps.get("cypress"):
                discovery_lines[i] = "- **Test automation framework:** Cypress (detected in target repository)"
            elif caps.get("pytest"):
                discovery_lines[i] = "- **Test automation framework:** pytest (detected in target repository)"
        if "Automation language:" in line and lang and lang != "unknown":
            discovery_lines[i] = f"- **Automation language:** {lang.capitalize()} (detected in target repository)"
    # Section 2: Application Architecture
    for i, line in enumerate(discovery_lines):
        if "Frontend framework:" in line and caps.get("web"):
            discovery_lines[i] = "- **Frontend framework:** Detected web app in target repository."
        if "Backend framework:" in line and caps.get("api"):
            discovery_lines[i] = "- **Backend framework:** Detected API in target repository."
        if "Programming languages (production):" in line and lang and lang != "unknown":
            discovery_lines[i] = f"- **Programming languages (production):** {lang.capitalize()} (detected in target repository)"
    # Section 3: Test Architecture
    fw_list = []
    for fw_name, fw_key in [("Playwright", "playwright"), ("Cypress", "cypress"), ("Selenium", "selenium"), ("Appium", "appium"), ("pytest", "pytest"), ("JUnit/TestNG", "java_test")]:
        if caps.get(fw_key):
            fw_list.append(fw_name)
    fw_str = "; ".join(fw_list) if fw_list else "Not detected"
    for i, line in enumerate(discovery_lines):
        if "Existing test framework:" in line:
            discovery_lines[i] = f"- **Existing test framework:** {fw_str} ({'detected in target repository' if caps.get('existing_automation') else 'declared in project adapter'})"
        if "Existing test suites:" in line:
            td = caps.get("test_directory")
            if td:
                discovery_lines[i] = f"- **Existing test suites:** Detected test directory: {td}"
        if "Existing automation:" in line:
            discovery_lines[i] = f"- **Existing automation:** {'YES — detected in target repository' if caps.get('existing_automation') else 'Not detected'}"
        if "Test utilities/fixtures:" in line:
            if test_data:
                discovery_lines[i] = f"- **Test utilities/fixtures:** Detected: {'; '.join(d['path'] for d in test_data)}"
        if "CI test integration:" in line:
            if caps.get("ci"):
                discovery_lines[i] = "- **CI test integration:** CI configuration detected in target repository."
    # Section 4: API Architecture
    for i, line in enumerate(discovery_lines):
        if "REST API:" in line and caps.get("api"):
            discovery_lines[i] = "- **REST API:** Yes (detected in target repository)"
        if "GraphQL API:" in line and caps.get("graphql"):
            discovery_lines[i] = "- **GraphQL API:** Yes (detected in target repository)"
        if "Webhooks:" in line and caps.get("webhooks"):
            discovery_lines[i] = "- **Webhooks:** Yes (detected in target repository)"
    # Section 7: CI/CD
    for i, line in enumerate(discovery_lines):
        if "CI provider:" in line and caps.get("ci"):
            discovery_lines[i] = "- **CI provider:** CI configuration detected in target repository."
    # Section 8: Environments
    env_header_idx = None
    for i, line in enumerate(discovery_lines):
        if line.startswith("## 8. Environments"):
            env_header_idx = i
            break
    if env_header_idx is not None and environments:
        env_data = []
        for e in environments:
            if e.get("type") == "examples":
                vars = [v["name"] for v in e.get("variables", [])]
                env_data.append(f"- **Environment variables** (from `{e['source'].split('/')[-1]}`): {', '.join(vars)}")
                env_data.append("  - Values: NOT EXPOSED (for security)")
            elif e.get("base_url"):
                env_data.append(f"- **Base URL** (from `{e['source'].split('/')[-1]}`): {e['base_url']}")
            elif e.get("scripts"):
                scripts = list(e["scripts"].keys())
                env_data.append(f"- **Test scripts** (from `{e['source'].split('/')[-1]}`): {', '.join(scripts)}")
        if env_data:
            insert_at = env_header_idx + 2
            for j, ed in enumerate(env_data):
                discovery_lines.insert(insert_at + j, ed + "\n")
            discovery_lines.insert(insert_at + len(env_data), "\n")
    # Section 9: Test Coverage
    for i, line in enumerate(discovery_lines):
        if "Existing tests:" in line:
            if caps.get("test_directory"):
                discovery_lines[i] = f"- **Existing tests:** Detected in target repository at: {caps['test_directory']}"
        if "Test coverage:" in line and caps.get("existing_automation"):
            discovery_lines[i] = "- **Test coverage:** Test suite exists in target repository (coverage unknown)"
    # Section 13: Unknowns
    unk_idx = None
    for i, line in enumerate(discovery_lines):
        if line.startswith("## 13. Unknowns"):
            unk_idx = i
            break
    if unk_idx is not None:
        end_idx = len(discovery_lines)
        for i in range(unk_idx + 1, len(discovery_lines)):
            if discovery_lines[i].startswith("## "):
                end_idx = i
                break
        new_unk = []
        if not caps.get("existing_automation"):
            new_unk.append("- No existing test automation detected in target repository.")
        if not caps.get("test_directory"):
            new_unk.append("- Test directory not detected in target repository.")
        if not environments:
            new_unk.append("- No environment configuration detected in target repository.")
        if not test_data:
            new_unk.append("- No test data or fixtures detected in target repository.")
        if new_unk:
            item_start = None
            for i in range(unk_idx + 1, end_idx):
                if discovery_lines[i].startswith("- "):
                    item_start = i
                    break
            if item_start is not None:
                del discovery_lines[item_start:end_idx]
                for u in new_unk:
                    discovery_lines.insert(item_start, u + "\n")
                    item_start += 1
                discovery_lines.insert(item_start, "\n")


# ── Stage 3: Analysis ──────────────────────────────────────────────────────


def _execute_analysis(stage_name, story_id, story_source, project_config,
                      project_name, project_dir, stage_status):
    """Stage 3: Analysis — analyze requirements and produce an analysis report.

    Inputs: story-intake.md, discovery/output.md, project.yaml
    Outputs: shared-state/<story-id>/analysis/output.md
    Side effects: none
    """
    try:
        intake_text = load_stage_artifact(story_id, "story-intake.md")
        discovery_text = load_stage_artifact(story_id, "discovery/output.md")
    except FileNotFoundError as e:
        return "blocked", [f"Missing input: {e}"]

    sections = parse_markdown_sections(intake_text)
    user_story = sections.get("User Story", "").strip()
    title = sections.get("Title", sections.get("Story Title", story_id))
    ac_text = sections.get("Acceptance Criteria", "").strip()
    business_rules = sections.get("Business Rules", "").strip()
    notes = sections.get("Notes", "").strip()
    NL = "\n"

    ac_lines = [l for l in ac_text.splitlines() if l.strip()] if ac_text else []
    ac_items = []
    current_ac = None
    for line in ac_lines:
        if line.startswith("### "):
            if current_ac is not None:
                ac_items.append(current_ac)
            current_ac = {"heading": line[4:].strip(), "body": []}
        elif current_ac is not None:
            current_ac["body"].append(line)
    if current_ac is not None:
        ac_items.append(current_ac)

    A = []
    A.extend([
        f"# Requirement Analysis — {story_id}",
        "",
        f"**Project:** {project_name}",
        "**Source inputs:** story-intake.md, discovery/output.md, project.yaml",
        f"**Analysis timestamp:** {now_iso()}",
        "",
        "---",
        "",
        "## 1. Requirement Summary",
        "",
    ])

    A.append(user_story or "(No user story found in intake)")
    A.extend([
        "",
        f"**Story title:** {title}",
        "",
        "## 2. Functional Scenarios",
        "",
    ])

    if ac_text:
        A.append(ac_text)
    else:
        A.append("_(No acceptance criteria found in intake.)_")
    A.extend([
        "",
        "## 3. Negative Scenarios",
        "",
    ])

    if ac_items:
        for ac in ac_items:
            heading = ac["heading"]
            A.append(f"- **{heading} — failure variant:** The conditions required by this AC may not be met. Expected behavior when preconditions fail is not specified in the AC.")
        A.extend([
            "",
            "- **Invalid or missing inputs:** The acceptance criteria imply specific input validations. What happens when inputs are invalid, malformed, missing, or out of range is not specified for any AC.",
            "- **Precondition failure:** Each AC may depend on preconditions. Behavior when preconditions are not met is not specified.",
            "- **Dependency failure:** The feature may depend on external systems. Behavior when dependencies fail is not specified.",
            "- **Unspecified error handling:** The ACs describe expected outcomes but do not specify error messages or failure modes.",
            "",
        ])
    else:
        A.extend([
            "_(No acceptance criteria available to derive negative scenarios.)_",
            "",
        ])

    A.extend([
        "## 4. Edge Cases",
        "",
    ])

    edge_cases = []
    if business_rules:
        rules = [r.strip() for r in business_rules.splitlines() if r.strip().startswith("-")]
        for rule in rules:
            rule_text = rule[1:].strip() if rule.startswith("-") else rule
            edge_cases.append(f"- **Business rule boundary:** The rule '{rule_text}' implies a boundary condition. Behavior at the boundary is not specified.")
        if any("expire" in r.lower() for r in rules):
            edge_cases.append("- **Expiry boundary:** If the feature involves time-based expiry, behavior at the exact expiry boundary is not specified.")
        if any("once" in r.lower() for r in rules):
            edge_cases.append("- **Re-use attempt:** If something can only be used once, behavior on re-use is not specified.")
        if any("password" in r.lower() or "policy" in r.lower() for r in rules):
            edge_cases.append("- **Policy boundary:** If a password policy exists, behavior at the policy boundaries is not specified.")

    edge_cases.extend([
        "- **Empty or null inputs:** Behavior when required inputs are empty or null is not specified.",
        "- **Very large inputs:** Behavior when inputs exceed expected size limits is not specified.",
        "- **Repeated operations:** Behavior when the same operation is attempted multiple times rapidly is not specified.",
        "- **Network or system failure:** Behavior when the network fails or the system is unavailable is not specified.",
        "- **Partial completion:** Behavior when an operation completes partially is not specified.",
    ])

    for ec in edge_cases:
        A.append(ec)
    A.extend([
        "",
        "## 5. Integration Risks",
        "",
    ])

    api = project_config.get("api", {})
    app = project_config.get("application", {})
    integration_risks = []

    if api.get("rest"):
        integration_risks.append("- **REST API dependency:** The project declares a REST API. If the feature involves API calls, endpoints and contracts are not specified.")
    if api.get("graphql"):
        integration_risks.append("- **GraphQL API dependency:** The project declares a GraphQL API. If the feature involves GraphQL, schema and queries are not specified.")
    if app.get("web"):
        integration_risks.append("- **Web interface dependency:** The project declares a web application. If the feature involves a web UI, page URLs and behavior are not specified.")
    if app.get("api"):
        integration_risks.append("- **API interface dependency:** The project declares an API. If the feature is API-accessible, the contract is not specified.")

    integration_risks.extend([
        "- **No environment configured:** No dev/staging/production environment is enabled. Integration testing requires an environment.",
        "- **No existing test automation:** No test suites or automation scripts were detected.",
        "- **External service dependency:** If the feature involves email delivery or other external services, the integration mechanism and failure handling are not specified.",
    ])

    for ir in integration_risks:
        A.append(ir)
    A.extend([
        "",
        "## 6. Data Risks",
        "",
    ])

    data_risks = []
    if ac_items:
        for ac in ac_items:
            body = NL.join(ac["body"]).strip()
            if "registered user" in body.lower() or "exists" in body.lower():
                data_risks.append("- **Precondition data dependency:** The AC requires a pre-existing entity. How this entity is created and whether entities are pre-seeded are not specified.")
                break
        if any("email" in NL.join(ac["body"]).lower() for ac in ac_items):
            data_risks.append("- **Email data dependency:** The feature involves email addresses. Validation rules, uniqueness constraints, and storage/privacy handling are not specified.")
        if any("code" in NL.join(ac["body"]).lower() for ac in ac_items):
            data_risks.append("- **Verification code data:** If verification codes are used, their generation, storage, format, and entropy are not specified.")
        if any("password" in NL.join(ac["body"]).lower() for ac in ac_items):
            data_risks.append("- **Password data:** If passwords are involved, storage (hashing), transmission (encryption), and policy enforcement are not specified.")

    if not data_risks:
        data_risks.append("- **Data preconditions:** The acceptance criteria may depend on pre-existing data. The test data setup is not defined.")

    data_risks.extend([
        "- **Test credentials needed:** Valid and invalid test credentials are required to execute tests. No credentials are available.",
        "- **User state dependency:** The feature may depend on user state. The test data setup for user state is not defined.",
    ])

    for dr in data_risks:
        A.append(dr)
    A.extend([
        "",
        "## 7. Regression Risks",
        "",
    ])

    regression_risks = [
        f"- **{title} is a user-facing feature:** Any change could break the acceptance criteria. Regression tests should cover all ACs.",
        "- **No existing test suite:** Without existing tests, there is no regression safety net.",
    ]

    if ac_items and len(ac_items) > 1:
        regression_risks.append("- **Sequential AC dependency:** Multiple ACs may represent a multi-step flow. A change to an early step could break later steps.")
    if business_rules:
        regression_risks.append("- **Business rule changes:** If business rules change, feature behavior changes. Regression tests should validate against current rules.")

    for rr in regression_risks:
        A.append(rr)
    A.extend([
        "",
        "## 8. Missing Information",
        "",
    ])

    missing = [
        "- **Application URL / base URL:** Not specified in project adapter or intake.",
        "- **Valid test credentials or samples:** Not available.",
        "- **API endpoints for the feature:** Not specified (REST API declared but no endpoints).",
        "- **Error message text:** Acceptance criteria describe expected outcomes but do not specify error message text.",
        "- **Frontend framework and backend framework:** Not declared in project adapter.",
    ]

    if ac_items:
        if any("email" in NL.join(ac["body"]).lower() for ac in ac_items):
            missing.append("- **Email delivery mechanism:** If the feature sends emails, the delivery mechanism, templates, and timing are not specified.")
        if any("code" in NL.join(ac["body"]).lower() for ac in ac_items):
            missing.append("- **Verification code details:** Code format, length, charset, generation method, and delivery mechanism are not specified.")
        if any("password" in NL.join(ac["body"]).lower() for ac in ac_items):
            missing.append("- **Password policy details:** Password rules (length, complexity, character requirements) are not specified.")
        if any("expire" in NL.join(ac["body"]).lower() or "expir" in NL.join(ac["body"]).lower() for ac in ac_items):
            missing.append("- **Expiry timing:** The exact expiry duration and behavior at expiry boundaries are not specified.")
        if any("registered" in NL.join(ac["body"]).lower() or "exists" in NL.join(ac["body"]).lower() for ac in ac_items):
            missing.append("- **User/entity creation flow:** How the precondition entity is created is not specified.")

    for m in missing:
        A.append(m)
    A.extend([
        "",
        "## 9. Questions",
        "",
    ])

    questions = [
        "Q1: Should the intake artifact be regenerated from the current story file before analysis proceeds?",
    ]

    if ac_items:
        questions.append("Q2: What are the valid test inputs for testing each AC?")
        questions.append("Q3: What is the expected error message text for each failure variant of the ACs?")
        questions.append(f"Q4: What is the {title} page URL or endpoint for testing?")
        if any("email" in NL.join(ac["body"]).lower() for ac in ac_items):
            questions.append("Q5: How are verification codes delivered (email, SMS, in-app)? What is the expected delivery time?")
        if any("code" in NL.join(ac["body"]).lower() for ac in ac_items):
            questions.append("Q6: What is the format, length, and expiry time for verification codes?")
        if any("registered" in NL.join(ac["body"]).lower() or "exists" in NL.join(ac["body"]).lower() for ac in ac_items):
            questions.append("Q7: Is there a setup or creation flow, or are test users pre-seeded?")
        if any("password" in NL.join(ac["body"]).lower() for ac in ac_items):
            questions.append("Q8: What is the password policy (minimum length, complexity requirements)?")

    questions.append("Q9: Is the feature accessed via a web UI, a REST API, or both?")
    questions.append("Q10: Are there any session or state requirements between steps?")

    for q in questions:
        A.append(q)
    A.extend([
        "",
        "## 10. QA Recommendations",
        "",
    ])

    recommendations = [
        "Provide test environment and credentials before execution. No environment is enabled and no credentials are available.",
        "Define the integration point (UI vs API) so that the correct test level can be selected.",
    ]

    if ac_items:
        recommendations.append("Create a test data setup for the preconditions required by each AC.")
        recommendations.append("Prioritize the primary ACs as the first test scenarios, with negative and edge cases as secondary.")
        if business_rules:
            recommendations.append("Validate business rules as part of test execution to ensure the feature enforces them correctly.")

    recommendations.extend([
        "Add edge-case and regression coverage once the intake is stable and environment is available.",
    ])

    for r in recommendations:
        A.append(f"- **{r}**")
    A.extend([
        "",
        "---",
        "",
        f"*Analysis performed by qa-run runtime. Report is grounded in story-intake.md, discovery/output.md, and project.yaml only. No business rules, URLs, credentials, selectors, API contracts, or database schemas were invented. Negative scenarios, edge cases, and risks are derived from the acceptance criteria, business rules, and project configuration.*",
    ])

    content = NL.join(A)
    art = write_stage_artifact(story_id, "analysis/output.md", content)
    return "completed", [art]


