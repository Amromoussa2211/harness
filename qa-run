#!/usr/bin/env python3
"""
QA Run — Minimal runtime entry point for the QA Agent Harness.
Drives the workflow from orchestrator/workflow.md stage by stage.
One stage per invocation. Company-independent.
"""

import json
import os
import sys
import yaml
from datetime import datetime, timezone
from pathlib import Path

# ── Constants ──────────────────────────────────────────────────────────────

ROOT = Path(__file__).resolve().parent
WORKFLOW_STAGES_PATH = ROOT / "workflow-stages.json"
STAGE_STATUS_VERSION = "1"

SIX_STATUSES = {"pending", "in_progress", "completed", "blocked", "failed", "skipped"}

# ── Helpers ────────────────────────────────────────────────────────────────

def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def story_id_safe(story_id: str) -> str:
    return story_id.replace(".", "_").replace("/", "_")

def load_workflow_stages() -> list[str]:
    with open(WORKFLOW_STAGES_PATH) as f:
        data = json.load(f)
    return data["stages"]

def parse_markdown_sections(text: str) -> dict[str, str]:
    """Split markdown into sections keyed by top-level heading."""
    sections: dict[str, str] = {}
    current: str | None = None
    current_lines: list[str] = []
    for line in text.splitlines():
        if line.startswith("# ") and not line.startswith("## "):
            # Level-1 heading: new section
            if current is not None:
                sections[current] = "\n".join(current_lines).strip()
            current = line[2:].strip()
            current_lines = []
        elif line.startswith("## ") and not line.startswith("### "):
            # Level-2 heading: new section (capture these too so sub-sections
            # in story files like ## Title / ## User Story / ## Acceptance Criteria
            # are individually accessible)
            if current is not None:
                sections[current] = "\n".join(current_lines).strip()
            current = line[3:].strip()
            current_lines = []
        else:
            if current is not None:
                current_lines.append(line)
    if current is not None:
        sections[current] = "\n".join(current_lines).strip()
    return sections

def load_stage_artifact(story_id: str, filename: str) -> str:
    path = ROOT / "shared-state" / story_id / filename
    with open(path) as f:
        return f.read()

def write_stage_artifact(story_id: str, filename: str, content: str) -> str:
    dir_path = ROOT / "shared-state" / story_id / os.path.dirname(filename)
    dir_path.mkdir(parents=True, exist_ok=True)
    full_path = ROOT / "shared-state" / story_id / filename
    with open(full_path, "w") as f:
        f.write(content)
    return str(full_path.relative_to(ROOT))

def load_project_adapter(project_name: str) -> dict:
    path = ROOT / "projects" / project_name / "project.yaml"
    with open(path) as f:
        return yaml.safe_load(f)

def stage_output_path(story_id: str, stage_name: str) -> Path:
    return ROOT / "shared-state" / story_id / stage_name

# ── Story Path Validation ──────────────────────────────────────────────────

def validate_story_path(raw_path: str) -> tuple[Path, dict]:
    """Validate story path and return (resolved_path, project_info)."""
    p = Path(raw_path)
    if not p.is_absolute():
        p = ROOT / raw_path
    p = p.resolve()

    parts = p.parts
    try:
        projects_idx = parts.index("projects")
    except ValueError:
        print(f"Error: story path must be under projects/ : {raw_path}", file=sys.stderr)
        sys.exit(2)

    if len(parts) < projects_idx + 3:
        print(f"Error: story path shape must be projects/<project>/stories/<story-id>.md : {raw_path}", file=sys.stderr)
        sys.exit(2)

    project_name = parts[projects_idx + 1]
    stories_idx = parts.index("stories")
    if stories_idx != projects_idx + 2:
        print(f"Error: expected projects/<project>/stories/<story-id>.md : {raw_path}", file=sys.stderr)
        sys.exit(2)

    story_id = parts[projects_idx + 3]
    if not story_id.endswith(".md"):
        print(f"Error: story file must end with .md : {raw_path}", file=sys.stderr)
        sys.exit(2)
    story_id = story_id[:-3]

    if not p.exists():
        print(f"Error: story file not found: {p}", file=sys.stderr)
        sys.exit(2)

    project_dir = ROOT / "projects" / project_name
    if not project_dir.is_dir():
        print(f"Error: project directory not found: {project_dir}", file=sys.stderr)
        sys.exit(2)

    adapter_path = project_dir / "project.yaml"
    if not adapter_path.exists():
        print(f"Error: project adapter not found: {adapter_path}", file=sys.stderr)
        sys.exit(2)

    project_info = {
        "project_name": project_name,
        "story_id": story_id,
        "story_path": str(p),
        "project_dir": str(project_dir),
        "adapter_path": str(adapter_path),
    }
    return p, project_info

# ── Stage Status ───────────────────────────────────────────────────────────

def build_fresh_status(stage_order: list[str], story_id: str) -> dict:
    stages = {}
    for name in stage_order:
        stages[name] = {
            "status": "pending",
            "started_at": None,
            "completed_at": None,
            "blocked_reason": None,
            "failed_reason": None,
            "skip_reason": None,
            "artifacts": [],
            "notes": "",
        }
    stages["story-intake"]["status"] = "in_progress"
    return {
        "run_id": story_id_safe(story_id),
        "overall_status": "running",
        "started_at": now_iso(),
        "created_at": now_iso(),
        "stages": stages,
        "project": "",
        "story": "",
        "workflow_version": STAGE_STATUS_VERSION,
    }

def load_stage_status(story_id: str) -> dict | None:
    path = ROOT / "shared-state" / story_id / "stage-status.json"
    if not path.exists():
        return None
    with open(path) as f:
        return json.load(f)

def save_stage_status(story_id: str, status: dict) -> None:
    dir_path = ROOT / "shared-state" / story_id
    dir_path.mkdir(parents=True, exist_ok=True)
    path = dir_path / "stage-status.json"
    with open(path, "w") as f:
        json.dump(status, f, indent=2)
        f.write("\n")

def calculate_overall_status(stages: dict) -> str:
    statuses = {s["status"] for s in stages.values()}
    if statuses == {"completed"} or (statuses <= {"completed", "skipped"} and all(
        s["status"] == "skipped" or s["status"] == "completed" for s in stages.values()
    )):
        return "completed"
    if "failed" in statuses:
        return "failed"
    if "blocked" in statuses:
        return "blocked"
    if "in_progress" in statuses:
        return "running"
    if any(s["status"] in ("completed", "skipped") for s in stages.values()):
        return "partial"
    return "running"

def find_first_pending_stage(stage_order: list[str], stages: dict) -> str | None:
    for name in stage_order:
        st = stages[name]["status"]
        if st not in ("completed", "skipped"):
            return name
    return None

# ── Stage Execution ────────────────────────────────────────────────────────

def execute_stage(
    stage_name: str,
    story_id: str,
    story_source: str,
    project_config: dict,
    project_name: str,
    project_dir: str,
    stage_status: dict,
) -> tuple[str, list[str]]:
    """Execute one stage. Returns (status, artifact_paths)."""
    handlers = {
        "story-intake": _execute_story_intake,
        "discovery": _execute_discovery,
        "analysis": _execute_analysis,
        "grill": _execute_grill,
        "risk": _execute_risk,
        "architecture": _execute_architecture,
        "specification": _execute_specification,
        "test-design": _execute_test_design,
        "delegation": _execute_delegation,
        "execution": _execute_execution,
        "failure-analysis": _execute_failure_analysis,
        "review": _execute_review,
        "evidence": _execute_evidence,
        "final-report": _execute_final_report,
    }

    handler = handlers.get(stage_name)
    if handler is None:
        return "blocked", [f"Unknown stage: {stage_name}"]

    return handler(stage_name, story_id, story_source, project_config,
                   project_name, project_dir, stage_status)

# ── Stage 1: Story Intake ──────────────────────────────────────────────────

def _execute_story_intake(stage_name, story_id, story_source, project_config,
                          project_name, project_dir, stage_status):
    story_text = load_stage_artifact(story_id, story_source) if story_source else ""
    if not story_text.strip():
        return "failed", ["story file is empty"]

    sections = parse_markdown_sections(story_text)
    # Title: prefer ## Title section if present, otherwise use story_id from the
    # level-1 heading (e.g. "# STORY-001" → "STORY-001")
    title = sections.get("Title", sections.get("Story Title", story_id))
    user_story = sections.get("User Story", "")
    acceptance = sections.get("Acceptance Criteria", "")
    business_rules = sections.get("Business Rules", "")
    notes = sections.get("Notes", "")

    intake_lines = [
        f"# Story Intake — {story_id}",
        "",
        f"**Source:** {story_source}",
        f"**Project:** {project_name}",
        f"**Story ID:** {story_id}",
        f"**Intake timestamp:** {now_iso()}",
        "",
        "---",
        "",
        f"## Story Title",
        "",
        title.strip(),
        "",
        "## User Story",
        "",
        user_story.strip(),
        "",
    ]

    if acceptance.strip():
        intake_lines.append("## Acceptance Criteria")
        intake_lines.append("")
        intake_lines.append(acceptance.strip())
        intake_lines.append("")
    else:
        intake_lines.append("## Acceptance Criteria")
        intake_lines.append("")
        intake_lines.append("_(No acceptance criteria found in story file.)_")
        intake_lines.append("")

    if business_rules.strip():
        intake_lines.append("## Business Rules")
        intake_lines.append("")
        intake_lines.append(business_rules.strip())
        intake_lines.append("")

    if notes.strip():
        intake_lines.append("## Notes")
        intake_lines.append("")
        intake_lines.append(notes.strip())
        intake_lines.append("")

    intake_lines.extend([
        "## Project Configuration Summary",
        "",
    ])
    pc = project_config
    app = pc.get("application", {})
    autom = pc.get("automation", {})
    api = pc.get("api", {})
    db = pc.get("database", {})
    env = pc.get("environments", {})
    safety = pc.get("safety", {})

    def g(d, k, default="Not specified"):
        v = d.get(k, default)
        return v if v is not None else default

    intake_lines.extend([
        f"- **Project name:** {project_name}",
        f"- **Description:** {g(pc, 'description', 'N/A')}",
        f"- **Application — web:** {g(app, 'web')}",
        f"- **Application — api:** {g(app, 'api')}",
        f"- **Application — mobile:** {g(app, 'mobile')}",
        f"- **Automation framework:** {g(autom, 'framework')}",
        f"- **Automation language:** {g(autom, 'language')}",
        f"- **API — REST:** {g(api, 'rest')}",
        f"- **API — GraphQL:** {g(api, 'graphql')}",
        f"- **API — webhooks:** {g(api, 'webhooks')}",
        f"- **Database enabled:** {g(db, 'enabled')}",
        f"- **Database type:** {g(db, 'type')}",
        f"- **Environment — dev:** {g(env, 'dev')}",
        f"- **Environment — staging:** {g(env, 'staging')}",
        f"- **Environment — production:** {g(env, 'production')}",
        f"- **Safety — production execution:** {g(safety, 'production_execution')}",
        f"- **Safety — real payments:** {g(safety, 'real_payments')}",
        f"- **Safety — destructive database operations:** {g(safety, 'destructive_database_operations')}",
        "",
        "## Known Constraints",
        "",
    ])
    if not g(safety, 'production_execution'):
        intake_lines.append("- Production execution is disabled by project safety configuration.")
    if not g(safety, 'real_payments'):
        intake_lines.append("- Real payment transactions are disabled by project safety configuration.")
    if not g(safety, 'destructive_database_operations'):
        intake_lines.append("- Destructive database operations are disabled by project safety configuration.")
    if not any(g(env, k) for k in ('dev', 'staging', 'production')):
        intake_lines.append("- No environments are enabled in the project adapter.")
    intake_lines.extend([
        "",
        "## Unknown or Missing Information",
        "",
        "- No application URL or base URL specified.",
        "- No valid test credentials available.",
        "",
    ])

    content = "\n".join(intake_lines)
    art = write_stage_artifact(story_id, "story-intake.md", content)
    return "completed", [art]

