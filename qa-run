# ── Stage 5: Risk Analysis ─────────────────────────────────────────────────

def _execute_risk(stage_name, story_id, story_source, project_config,
                  project_name, project_dir, stage_status):
    try:
        grill_text = load_stage_artifact(story_id, "grill/output.md")
        analysis_text = load_stage_artifact(story_id, "analysis/output.md")
        discovery_text = load_stage_artifact(story_id, "discovery/output.md")
        intake_text = load_stage_artifact(story_id, "story-intake.md")
    except FileNotFoundError as e:
        return "blocked", [f"Missing input: {e}"]

    # Parse all inputs
    grill_sections = parse_markdown_sections(grill_text)
    analysis_sections = parse_markdown_sections(analysis_text)
    discovery_sections = parse_markdown_sections(discovery_text)
    intake_sections = parse_markdown_sections(intake_text)

    # Extract story identity
    story_title = intake_sections.get("Story Title", intake_sections.get("Title", story_id))
    user_story = intake_sections.get("User Story", "").strip()
    NL = "\n"

    # Extract grill findings
    grill_ambiguities_text = grill_sections.get("Ambiguities", "")
    grill_missing_text = grill_sections.get("Missing Requirements", "")
    grill_negative_text = grill_sections.get("Negative Scenarios", "")
    grill_edge_text = grill_sections.get("Edge Cases", "")
    grill_integration_text = grill_sections.get("Integration Risks", "")
    grill_regression_text = grill_sections.get("Regression Risks", "")
    grill_blockers_text = grill_sections.get("Blockers for Specification", "")

    # Extract analysis findings
    analysis_integration_text = analysis_sections.get("Integration Risks", "")
    analysis_data_text = analysis_sections.get("Data Risks", "")
    analysis_regression_text = analysis_sections.get("Regression Risks", "")
    analysis_missing_text = analysis_sections.get("Missing Information", "")

    # Extract discovery findings
    discovery_risks_text = discovery_sections.get("Risks", "")
    discovery_unknowns_text = discovery_sections.get("Unknowns", "")
    discovery_env_text = discovery_sections.get("Environments", "")

    # Project adapter values
    app = project_config.get("application", {})
    api = project_config.get("api", {})
    db = project_config.get("database", {})
    env = project_config.get("environments", {})
    ci = project_config.get("ci", {})
    safety = project_config.get("safety", {})
    env_enabled = any(env.get(k) for k in ("dev", "staging", "production"))

    # Helper: extract items from a section (lines starting with "- ")
    def extract_items(section_text):
        if not section_text:
            return []
        items = []
        for line in section_text.splitlines():
            s = line.strip()
            if s.startswith("- **") or s.startswith("- "):
                items.append(s)
        return items

    # Helper: extract item name from "- **Name:** description"
    def item_name(item_line):
        if ":**" in item_line:
            return item_line.split(":**", 1)[0].replace("- **", "").strip()
        return item_line.replace("- ", "").strip()

    # Helper: add a risk entry
    risk_counters = {"BR": 0, "TR": 0, "IR": 0, "DR": 0, "RR": 0}

    def add_risk(category, title, source, impact, mitigation, severity):
        risk_counters[category] += 1
        rid = f"{category}-{risk_counters[category]}"
        lines_list = [
            f"- **{rid}: {title} (Severity: {severity})**",
            f"  - Source: {source}",
            f"  - Impact: {impact}",
            f"  - Mitigation: {mitigation}",
            "",
        ]
        R_extended.extend(lines_list)

    R_extended = []

    # ── Header ──
    R_extended.extend([
        f"# Risk Analysis — {story_id}",
        "",
        f"**Project:** {project_name}",
        "**Source inputs:** grill/output.md, analysis/output.md, discovery/output.md, project.yaml",
        f"**Risk analysis timestamp:** {now_iso()}",
        "",
        "---",
        "",
        "## 1. Purpose",
        "",
        f"This risk analysis identifies and prioritizes risks to the successful delivery and testing of the {story_title} feature, based ONLY on findings from the grill, analysis, discovery, and project adapter. No risks are invented. Risks are contextualized and prioritized where determinable.",
        "",
        "## 2. Risk Identification Methodology",
        "",
        "Risks were identified by cross-referencing the grill output (ambiguities, missing requirements, negative scenarios, edge cases, integration risks, regression risks, blockers) with the analysis output (functional scenarios, data risks, integration risks, regression risks, missing information) and the discovery report (technology stack, application architecture, test architecture, environments, unknowns).",
        "",
        "Each risk below is tied to a specific finding from a prior stage. Risks are categorized as: Business, Technical, Integration, Data, or Regression.",
        "",
    ])

    # ── 3. Business Risks ──
    R_extended.extend(["## 3. Business Risks", ""])

    business_risks_from_grill = []

    # From ambiguities
    for amb in extract_items(grill_ambiguities_text):
        business_risks_from_grill.append((
            f"Unresolved ambiguity: {item_name(amb)}",
            f"Grill Section 3 (ambiguities).",
            f"The term or concept '{item_name(amb)}' is ambiguous. Until clarified, test scope and expected outcomes cannot be reliably determined.",
            f"Human stakeholder must clarify this ambiguity before specification begins.",
            "High" if any(w in amb.lower() for w in ["cannot", "block", "must"]) else "Medium"
        ))

    # From missing requirements
    for miss in extract_items(grill_missing_text):
        business_risks_from_grill.append((
            f"Missing requirement: {item_name(miss)}",
            f"Grill Section 4 (missing requirements).",
            f"The requirement '{item_name(miss)}' is not defined. The feature may not meet user expectations without this.",
            f"Product owner must define this requirement.",
            "Medium"
        ))

    # From blockers
    for blk in extract_items(grill_blockers_text):
        business_risks_from_grill.append((
            f"Blocker for specification: {item_name(blk)}",
            f"Grill Section 13 (blockers for specification).",
            f"This item blocks the specification stage from producing reliable coverage.",
            f"Must be resolved before specification can proceed.",
            "High"
        ))

    if business_risks_from_grill:
        for title, source, impact, mitigation, severity in business_risks_from_grill:
            add_risk("BR", title, source, impact, mitigation, severity)
    else:
        R_extended.append("- No business risks identified from the available inputs.")
        R_extended.append("")

    # ── 4. Technical Risks ──
    R_extended.extend(["## 4. Technical Risks", ""])

    technical_risks = []

    # Environment risk
    if not env_enabled:
        technical_risks.append((
            "No environments enabled — execution is blocked",
            "Discovery Section 8 (no environments enabled), Project adapter (environments.dev=false, staging=false, production=false).",
            "No test environment exists. No Playwright tests, API tests, or any execution can proceed until at least a test environment is configured.",
            "At least a dev or staging environment must be added to the project adapter before execution. This is a hard blocker for Stages 6–14.",
            "Critical"
        ))
    elif any(env.get(k) for k in ("dev", "staging", "production")):
        enabled_envs = [k for k, v in env.items() if v]
        technical_risks.append((
            f"Environment(s) enabled but must be validated: {', '.join(enabled_envs)}",
            f"Project adapter (environments: {', '.join(enabled_envs)} = true).",
            "The declared environments must be reachable and properly configured for test execution.",
            "Verify environment accessibility before test execution.",
            "Low"
        ))

    # Application under test risk
    discovery_has_app_risk = any("application" in r.lower() and ("no " in r.lower() or "not " in r.lower()) for r in extract_items(discovery_risks_text))
    if discovery_has_app_risk or not discovery_sections.get("Application Architecture", ""):
        technical_risks.append((
            "No application under test detected",
            "Discovery report — no application source code or running application found in the repository.",
            "The repository contains no application source code and no running application. Execution has no target.",
            "Either application source code must be added to the repository, or the project adapter must point to an external application with access instructions.",
            "Critical"
        ))

    # Test framework risk
    fw = project_config.get("automation", {}).get("framework", "")
    if not fw or fw == "Not specified":
        technical_risks.append((
            "No test framework or automation in place",
            "Discovery report — no existing test framework, test suites, or automation detected.",
            "All test automation must be created from scratch. There is no regression safety net.",
            "Establish a test automation project before execution.",
            "High"
        ))

    # Auth/session ambiguity from analysis
    if "authentication" in analysis_integration_text.lower() or "session" in analysis_integration_text.lower():
        technical_risks.append((
            "Authentication or session flow is ambiguous",
            "Analysis output — authentication or session management not clearly defined.",
            "Test design cannot account for session behavior, token handling, or concurrency without this information.",
            "Clarify authentication mechanism and session management approach.",
            "Medium"
        ))

    # CI/CD risk
    if ci.get("provider", "none") == "none":
        technical_risks.append((
            "No CI/CD pipeline configured",
            f"Discovery report, Project adapter (ci.provider={ci.get('provider', 'none')}).",
            "No automated test execution pipeline exists. Test results are not automatically collected or reported.",
            "Not a blocker for manual testing, but a CI pipeline should be established for regression automation.",
            "Low"
        ))

    if technical_risks:
        for title, source, impact, mitigation, severity in technical_risks:
            add_risk("TR", title, source, impact, mitigation, severity)
    else:
        R_extended.append("- No technical risks identified from the available inputs.")
        R_extended.append("")

    # ── 5. Integration Risks ──
    R_extended.extend(["## 5. Integration Risks", ""])

    integration_risks = []

    if api.get("rest"):
        integration_risks.append((
            "REST API declared but endpoints may be unknown",
            "Discovery Section 4, Analysis Section 5, Grill Section 7.",
            "If the feature involves API calls, tests need endpoint URLs, request/response contracts, and authentication details.",
            "Document API endpoints and contracts before API-level testing can proceed.",
            "High"
        ))
    if api.get("graphql"):
        integration_risks.append((
            "GraphQL API declared but schema may be unknown",
            "Discovery Section 4, Analysis Section 5.",
            "If the feature involves GraphQL, tests need schema information and operation definitions.",
            "Document GraphQL schema and operations before GraphQL testing can proceed.",
            "High"
        ))
    if api.get("webhooks"):
        integration_risks.append((
            "Webhooks declared but event types may be unknown",
            "Discovery Section 4, Analysis Section 5.",
            "If the feature involves webhooks, tests need event types, payload structures, and endpoint URLs.",
            "Document webhook events and payloads before webhook testing can proceed.",
            "Medium"
        ))

    # Database integration
    if db.get("enabled"):
        integration_risks.append((
            f"Database enabled ({db.get('type', 'unknown')}) — schema and access may need definition",
            f"Project adapter (database.enabled=true, type={db.get('type', 'unknown')}).",
            "Database tests require schema information, connection details, and expected state definitions.",
            "Document database schema and expected state for testing.",
            "Medium"
        ))
    elif any("data" in r.lower() or "storage" in r.lower() or "credential" in r.lower() for r in extract_items(grill_integration_text + analysis_data_text)):
        integration_risks.append((
            "Data storage may be needed but database is not declared",
            "Analysis output, Grill output.",
            "If the feature requires persistent data storage, the project adapter's database setting may be incompatible.",
            "Confirm whether the feature requires a database and update the project adapter if needed.",
            "Medium"
        ))

    if integration_risks:
        for title, source, impact, mitigation, severity in integration_risks:
            add_risk("IR", title, source, impact, mitigation, severity)
    else:
        R_extended.append("- No integration risks identified from the available inputs.")
        R_extended.append("")

    # ── 6. Data Risks ──
    R_extended.extend(["## 6. Data Risks", ""])

    data_risks = []

    # Credentials
    if any("credential" in r.lower() for r in extract_items(grill_missing_text + analysis_data_text + discovery_unknowns_text)):
        data_risks.append((
            "No test credentials available",
            "Analysis output, Grill output, Discovery report.",
            "The feature requires valid and/or invalid test credentials. No credentials exist in the project adapter or shared state.",
            "Provide test credentials through the project adapter or test data setup.",
            "High"
        ))

    # Precondition data
    if any("precondition" in r.lower() or "pre-existing" in r.lower() or "registered user" in r.lower() for r in extract_items(grill_ambiguities_text + analysis_data_text)):
        data_risks.append((
            "Precondition data is undefined",
            "Analysis output, Grill output.",
            "The feature depends on pre-existing data entities. How these entities are created is unknown.",
            "Clarify the data creation/pre-seeding mechanism and provide a test data setup strategy.",
            "Medium"
        ))

    # Test data management
    if any("test data" in r.lower() and ("unknown" in r.lower() or "not specified" in r.lower()) for r in extract_items(discovery_unknowns_text)):
        data_risks.append((
            "No test data management strategy",
            "Discovery report — test data management unknown, no test utilities/fixtures detected.",
            "No fixtures, factories, or data seeding mechanism exists.",
            "Establish a test data management approach before execution.",
            "Low"
        ))

    if data_risks:
        for title, source, impact, mitigation, severity in data_risks:
            add_risk("DR", title, source, impact, mitigation, severity)
    else:
        R_extended.append("- No data risks identified from the available inputs.")
        R_extended.append("")

    # ── 7. Regression Risks ──
    R_extended.extend(["## 7. Regression Risks", ""])

    regression_risks = []

    # Core journey regression — derive from story title
    if story_title and story_title != story_id:
        regression_risks.append((
            f"{story_title} is a feature with no regression safety net",
            f"Analysis output, Grill output.",
            f"Any change to this feature could break the acceptance criteria. With no existing tests, there is no automated regression detection.",
            f"Prioritize automated regression tests for the acceptance criteria as the first test automation target.",
            "High"
        ))

    # No existing tests
    if any("No existing test" in r for r in extract_items(discovery_risks_text)):
        regression_risks.append((
            "No existing test suite",
            "Discovery report — no existing tests detected.",
            "Without existing tests, there is no regression safety net. All regression tests must be created from scratch.",
            "Create a minimal regression suite covering the primary acceptance criteria.",
            "High"
        ))

    # Business rule regression
    if business_rules := intake_sections.get("Business Rules", ""):
        if business_rules.strip():
            regression_risks.append((
                "Business rule changes could affect feature behavior",
                "Analysis output, Grill output.",
                "If business rules change, feature behavior changes. Regression tests should validate against current rules.",
                "Add regression tests that validate business rule enforcement.",
                "Medium"
            ))

    if regression_risks:
        for title, source, impact, mitigation, severity in regression_risks:
            add_risk("RR", title, source, impact, mitigation, severity)
    else:
        R_extended.append("- No regression risks identified from the available inputs.")
        R_extended.append("")

    # ── 8. Risks That Must Be Addressed Before Testing ──
    R_extended.extend([
        "## 8. Risks That Must Be Addressed Before Testing",
        "",
        "The following risks are hard blockers for Stages 6–14 (Test Architecture through Final Report). They must be resolved before the workflow can proceed beyond Risk Analysis:",
        "",
        "| ID | Risk | Severity | Resolution Required |",
        "|----|------|----------|-------------------|",
    ])

    blocking = []
    for cat in ["BR", "TR", "IR", "DR", "RR"]:
        # Find risks with Critical or High severity that are blockers
        for i, line in enumerate(R_extended):
            if line.startswith(f"- **{cat}-") and "Critical" in line:
                title = line.split("**", 1)[1].split(":")[1].strip()
                blocking.append((f"{cat}-?".rstrip("?"), title, "Critical", "Must be resolved before testing can proceed"))
            elif line.startswith(f"- **{cat}-") and "High" in line and any(w in line.lower() for w in ["block", "cannot", "must"]):
                title = line.split("**", 1)[1].split(":")[1].strip()
                blocking.append((f"{cat}-?", title, "High", "Must be resolved before testing can proceed"))

    # Also add from our structured data
    for cat, risks in [("TR", technical_risks), ("BR", business_risks_from_grill), ("IR", integration_risks), ("DR", data_risks), ("RR", regression_risks)]:
        for title, source, impact, mitigation, severity in risks:
            if severity in ("Critical", "High") and any(w in impact.lower() for w in ["block", "cannot", "must", "no ", "not "]):
                # Deduplicate
                if not any(b[0] == cat + "-" and title in b[1] for b in blocking):
                    blocking.append((f"{cat}-?", title, severity, mitigation))

    if blocking:
        # Deduplicate by title
        seen = set()
        unique_blocking = []
        for bid, btitle, bsev, bmit in blocking:
            key = btitle[:80]
            if key not in seen:
                seen.add(key)
                unique_blocking.append((bid, btitle, bsev, bmit))

        for bid, btitle, bsev, bmit in unique_blocking:
            R_extended.append(f"| {bid} | {btitle} | {bsev} | {bmit} |")
    else:
        R_extended.append("| None | No hard blockers identified | — | Workflow can proceed |")

    R_extended.append("")

    # ── 9. Risks That Do Not Block Testing ──
    R_extended.extend([
        "## 9. Risks That Do Not Block Testing",
        "",
        "The following risks are noted but do not prevent the workflow from proceeding once the above blockers are resolved:",
        "",
    ])

    non_blocking = []
    for cat in ["BR", "TR", "IR", "DR", "RR"]:
        for i, line in enumerate(R_extended):
            if line.startswith(f"- **{cat}-") and ("Medium" in line or "Low" in line):
                title = line.split("**", 1)[1].split(":")[1].strip()
                sev = "Medium" if "Medium" in line else "Low"
                non_blocking.append(f"- **{title}** — {sev} severity. Can be addressed during later stages.")

    if non_blocking:
        R_extended.extend(non_blocking)
    else:
        R_extended.append("- No non-blocking risks identified.")

    R_extended.append("")

    # ── 10. Assumptions ──
    R_extended.extend([
        "## 10. Assumptions",
        "",
        "- The project adapter is accurate and current. If it is outdated, the environment and safety assessments above may be incorrect.",
        f"- The story file is the authoritative source for the {story_title} requirement. If the story has been updated since intake, the intake artifact should be regenerated.",
        "- No company-specific information has been used. All risks are derived from the project adapter, discovery report, analysis output, and grill output only.",
        "",
    ])

    # ── 11. Unknowns ──
    R_extended.extend([
        "## 11. Unknowns",
        "",
    ])

    unknowns_set = set()
    for u in extract_items(discovery_unknowns_text):
        unknowns_set.add(u.replace("- ", "").strip())
    for u in extract_items(analysis_missing_text):
        unknowns_set.add(u.replace("- ", "").strip())

    if unknowns_set:
        for u in sorted(unknowns_set)[:10]:
            R_extended.append(f"- {u}")
    else:
        R_extended.append("- No significant unknowns identified from prior stages.")

    R_extended.append("")
    R_extended.extend([
        "---",
        "",
        f"*Risk analysis performed by qa-run runtime. Risks are grounded in grill/output.md, analysis/output.md, discovery/output.md, and project.yaml only. No risks were invented. Risks that must be resolved before testing are clearly identified in Section 8.*",
    ])

    content = NL.join(R_extended)
    art = write_stage_artifact(story_id, "risk/output.md", content)
    return "completed", [art]


# ── Stage 6: Test Architecture ─────────────────────────────────────────────



def _execute_architecture(stage_name, story_id, story_source, project_config,

                          project_name, project_dir, stage_status):

    try:

        grill_text = load_stage_artifact(story_id, "grill/output.md")

        analysis_text = load_stage_artifact(story_id, "analysis/output.md")

        risk_text = load_stage_artifact(story_id, "risk/output.md")

        discovery_text = load_stage_artifact(story_id, "discovery/output.md")

    except FileNotFoundError as e:

        return "blocked", [f"Missing input: {e}"]



    env = project_config.get("environments", {})

    env_enabled = any(env.get(k) for k in ("dev", "staging", "production"))



    arch_lines = [

        f"# Test Architecture — {story_id}",

        "",

        f"**Project:** {project_name}",

        "**Source inputs:** grill/output.md, analysis/output.md, risk/output.md, discovery/output.md, project.yaml",

        f"**Architecture timestamp:** {now_iso()}",

        "",

        "---",

        "",

        "## 1. Test Strategy",

        "",

        "- **Primary test level:** Based on the feature interface (UI, API, or both) as determined by the project adapter and story analysis. Unit/component tests for business logic (if backend code exists), integration tests for API endpoints (if API is in scope), and end-to-end tests via Playwright for UI flows (if web UI is in scope).",

        "- **Test pyramid preference:** Lowest appropriate layer first. Unit tests for business logic validation, integration tests for API endpoints, E2E tests for the full user journey through the UI.",

        "- **Scope:** The acceptance criteria from the story intake, plus the negative and edge cases identified in the grill and analysis.",

        "",

        "## 2. Test Pyramid",

        "",

        "- **Unit layer:** Business logic validation functions, data transformation logic, error condition checking. (Requires application source code.)",

        "- **Integration layer:** API endpoints for the feature (if API-based interaction is confirmed). (Requires API endpoints and credentials.)",

        "- **E2E layer:** Full user journey via Playwright — navigate to the feature entry point, perform the required interactions, and verify expected outcomes. (Requires application URL, credentials where applicable, and running environment.)",

        "",

        "## 3. Automation Strategy",

