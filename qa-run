    content = "\n".join(arch_lines)
    art = write_stage_artifact(story_id, "architecture/output.md", content)

    # Return blocked when environment is not available — this is a hard blocker
    if not env_enabled:
        return "blocked", [art, "No environments enabled in project adapter — execution cannot proceed"]
