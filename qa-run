# ── Stage 7: QA Specification ──────────────────────────────────────────────


def _execute_specification(stage_name, story_id, story_source, project_config,
                           project_name, project_dir, stage_status):
    """Stage 7: QA Specification — produce a detailed QA specification.

    Inputs: story-intake.md, grill/output.md, analysis/output.md, risk/output.md,
            architecture/output.md, discovery/output.md, project.yaml
    Outputs: shared-state/<story-id>/specification/output.md
    Side effects: none
    """
    try:
        grill_text = load_stage_artifact(story_id, "grill/output.md")
        analysis_text = load_stage_artifact(story_id, "analysis/output.md")
        risk_text = load_stage_artifact(story_id, "risk/output.md")
        arch_text = load_stage_artifact(story_id, "architecture/output.md")
        discovery_text = load_stage_artifact(story_id, "discovery/output.md")
        intake_text = load_stage_artifact(story_id, "story-intake.md")
    except FileNotFoundError as e:
        return "blocked", [f"Missing input: {e}"]

    # Parse all inputs
    grill_sections = parse_markdown_sections(grill_text)
    analysis_sections = parse_markdown_sections(analysis_text)
    intake_sections = parse_markdown_sections(intake_text)

    # Extract story identity
    story_title = intake_sections.get("Story Title", intake_sections.get("Title", story_id))
    user_story = intake_sections.get("User Story", "").strip()
    ac_text = intake_sections.get("Acceptance Criteria", "").strip()
    business_rules_text = intake_sections.get("Business Rules", "").strip()
    NL = "\n"

    # Parse acceptance criteria into items
    ac_items = []
    if ac_text:
        current = None
        for line in ac_text.splitlines():
            if line.startswith("### "):
                current = {"heading": line[4:].strip(), "body": []}
                ac_items.append(current)
            elif ac_items and current["heading"]:
                ac_items[-1]["body"].append(line)
            elif not ac_items:
                if line.strip() and not line.startswith("#"):
                    ac_items.append({"heading": line.strip(), "body": []})

    # Helper: extract list items
    def extract_items(section_text):
        if not section_text:
            return []
        items = []
        for line in section_text.splitlines():
            s = line.strip()
            if s.startswith("- **") or s.startswith("- "):
                items.append(s)
        return items

    # Project adapter
    app = project_config.get("application", {})
    api = project_config.get("api", {})
    db = project_config.get("database", {})
    env = project_config.get("environments", {})
    safety = project_config.get("safety", {})
    env_enabled = any(env.get(k) for k in ("dev", "staging", "production"))

    S = []

    # ── Header ──
    S.extend([
        f"# QA Specification — {story_id}",
        "",
        f"**Project:** {project_name}",
        "**Source inputs:** story-intake.md, grill/output.md, analysis/output.md, risk/output.md, architecture/output.md, discovery/output.md, project.yaml",
        f"**Specification timestamp:** {now_iso()}",
        "",
        "---",
        "",
        "## 1. Requirement under Specification",
        "",
    ])

    if user_story:
        S.append(user_story)
    else:
        S.append(f"(No user story found in intake for {story_id})")
    S.extend([f"Story: {story_id}", ""])

    # ── 2. Functional Coverage (dynamic from ACs) ──
    S.extend(["## 2. Functional Coverage", ""])

    if ac_items:
        for ac in ac_items:
            heading = ac["heading"]
            body = NL.join(ac["body"]).strip()
            S.extend([
                f"### {heading}",
                "",
                "| Aspect | Coverage | Status |",
                "|--------|----------|--------|",
                "| Precondition | " + ("Covered by AC statement" if "Given" in body else "Not specified in AC — may need test data setup"),
                "| Action | " + ("Covered by AC statement" if "When" in body else "Not specified in AC"),
                "| Expected outcome | " + ("Covered by AC statement" if "Then" in body else "Not specified in AC — expected outcome missing"),
            ])

            # Add dynamic blockage notes
            if "error" in body.lower() or "validation" in body.lower():
                if "message" in body.lower():
                    S.append("| Error message text | Not defined in AC | Blocked — error message text not defined |")
            if any(w in body.lower() for w in ["redirect", "navigate", "go to", "open", "Dashboard"]):
                S.append("| Destination/redirect target | Not defined in AC | Blocked — destination not defined |")
            if "registered" in body.lower() or "exists" in body.lower() or "pre-existing" in body.lower():
                S.append("| Precondition data setup | Test data setup required | Blocked — no credentials or creation mechanism available |")
            S.append("")
    else:
        S.extend(["_(No acceptance criteria found in intake. Functional coverage cannot be defined.)_", ""])

    # ── 3. Negative Coverage ──
    S.extend(["## 3. Negative Coverage", ""])

    grill_negative = grill_sections.get("Negative Scenarios", "")
    neg_items = extract_items(grill_negative)

    if neg_items:
        S.extend(["| Scenario | Expected Outcome | Status |", "|----------|-----------------|--------|"])

        for item in neg_items:
            name = item.split(":**", 1)[0].replace("- **", "").strip()
            rest = item.split(":**", 1)[1] if ":**" in item else item

            expected = "(see scenario description)"
            status = "Not specified"

            if "Expected:" in rest:
                expected = rest.split("Expected:", 1)[1].strip()
                if ".**" in expected:
                    expected = expected.split(".**")[0] + ".**"
                if "**Not specified" in expected or "**Not specified." in expected:
                    expected = "Not specified"
                    status = "Not specified"

            if "**Confirmed by acceptance criteria**" in item:
                status = "Confirmed by acceptance criteria"
            elif "**Not explicitly specified**" in item:
                status = "Not explicitly specified"

            S.append(f"| {name} | {expected} | {status} |")
        S.append("")
    else:
        S.append("_(No negative scenarios identified in grill output.)_")
        S.append("")

    # ── 4. Boundary Coverage ──
    S.extend(["## 4. Boundary Coverage", ""])

    boundaries = []

    # From business rules
    if business_rules_text:
        for rule in business_rules_text.splitlines():
            r = rule.strip()
            if r.startswith("-") and r.strip("- ").strip():
                rule_text = r.strip("- ").strip()
                if "expire" in rule_text.lower():
                    boundaries.append("| Time-based expiry boundary | Behavior at exact expiry moment | Not specified |")
                if "once" in rule_text.lower() or "only be used once" in rule_text.lower():
                    boundaries.append("| Re-use/duplicate attempt boundary | Behavior on re-use | Not specified |")
                if "password" in rule_text.lower() or "policy" in rule_text.lower():
                    boundaries.append("| Password policy boundary | Behavior at policy limits | Not specified |")

    # From AC analysis
    for ac in ac_items:
        body_lower = NL.join(ac["body"]).lower()
        if "email" in body_lower:
            boundaries.append("| Email field empty | Email validation error | Not specified in AC |")
            boundaries.append("| Email field very long input | Handling behavior | Not specified |")
        if "password" in body_lower:
            boundaries.append("| Password field empty | Password validation error | Not specified in AC |")
            boundaries.append("| Password field very long input | Handling behavior | Not specified |")
        if "code" in body_lower:
            boundaries.append("| Verification code format | Code format, length, charset | Not specified |")
            boundaries.append("| Verification code expiry | Expiry duration and behavior | Not specified |")
        if "amount" in body_lower or "price" in body_lower or "quantity" in body_lower:
            boundaries.append("| Numeric boundary (0, max, min) | Handling at limits | Not specified |")

    # Generic boundaries if none derived
    if not boundaries:
        boundaries = [
            "| Empty or null inputs | Validation error or rejection | Not specified |",
            "| Very large inputs | Handling behavior | Not specified |",
            "| Repeated operations | Idempotency behavior | Not specified |",
        ]

    S.extend(["| Boundary | Spec | Status |", "|----------|------|--------|"])
    S.extend(boundaries)
    S.append("")

    # ── 5. Integration Coverage ──
    S.extend(["## 5. Integration Coverage", ""])

    integration_points = []

    if api.get("rest"):
        integration_points.append("| REST API | API endpoint, request/response contract, authentication | Blocked — endpoints unknown |")
    if api.get("graphql"):
        integration_points.append("| GraphQL API | Operation, query/mutation, response types | Blocked — schema unknown |")
    if api.get("webhooks"):
        integration_points.append("| Webhooks | Event types, payload structure, endpoint URL | Blocked — webhook details unknown |")

    if app.get("web") and any("web" in nl.lower() or "ui" in nl.lower() or "page" in nl.lower() or "form" in nl.lower() for nl in [user_story, ac_text]):
        integration_points.append("| Web UI | Page URLs, UI interaction flow, browser state | Blocked — URLs and UI flow not specified |")

    if db.get("enabled"):
        integration_points.append("| Database | Schema, data access, transactions | Blocked — schema not specified |")
    elif any("data" in ip.lower() or "storage" in ip.lower() or "credential" in ip.lower() for ip in integration_points):
        integration_points.append("| Data storage | Persistent storage mechanism | Blocked — storage mechanism not specified |")

    if not env_enabled:
        integration_points.append("| Test environment | Dev or staging environment | Blocked — no environment enabled |")

    if integration_points:
        S.extend(["| Integration point | Spec | Status |", "|-------------------|------|--------|"])
        S.extend(integration_points)
    else:
        S.append("_(No integration points identified from project adapter.)_")
    S.append("")

    # ── 6. Validation Expectations ──
    S.extend(["## 6. Validation Expectations", ""])

    validations = []

    if ac_items:
        for ac in ac_items:
            heading = ac["heading"]
            body = NL.join(ac["body"]).strip()

            # Determine validation type
            if any(w in body.lower() for w in ["clicks", "enters", "type", "fill", "form", "field", "button", "page", "navigate", "redirect", "display"]):
                vtype = "UI validation"
            elif any(w in body.lower() for w in ["api", "endpoint", "request", "response", "status code", "http", "post", "get"]):
                vtype = "API validation"
            elif any(w in body.lower() for w in ["state", "updated", "created", "deleted", "stored", "saved"]):
                vtype = "State validation"
            else:
                vtype = "Behavior validation"

            # Extract expected
            expected = ""
            if "Then" in body:
                expected = body.split("Then", 1)[1].strip()
                if "." in expected:
                    expected = expected.split(".")[0].strip()

            status = "Defined in AC" if expected else "Blocked — expected outcome not fully defined"
            validations.append(f"| {heading} | {vtype} | {expected or '(see AC statement)'} | {status} |")

    if validations:
        S.extend(["| Validation | Type | Expected behavior | Status |", "|------------|------|-------------------|--------|"])
        S.extend(validations)
    else:
        S.append("_(No validation expectations can be defined — no acceptance criteria found.)_")
    S.append("")

    # ── 7. Required Test Data ──
    S.extend(["## 7. Required Test Data", ""])

    test_data = []

    if ac_items:
        needs_registered = any("registered" in NL.join(ac["body"]).lower() or "exists" in NL.join(ac["body"]).lower() or "pre-existing" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_valid = any("valid" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_invalid = any("invalid" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_code = any("code" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_email = any("email" in NL.join(ac["body"]).lower() for ac in ac_items)
        needs_password = any("password" in NL.join(ac["body"]).lower() for ac in ac_items)

        if needs_registered:
            test_data.append("- **Precondition entities:** Pre-existing entities required by the ACs (e.g., registered user, existing order). Blocked — creation mechanism not specified.")
        if needs_valid:
            test_data.append("- **Valid input samples:** Valid inputs required to test positive scenarios. Blocked — valid input values not specified.")
        if needs_invalid:
            test_data.append("- **Invalid input samples:** Invalid inputs required to test negative scenarios. Blocked — invalid input values not specified.")
        if needs_code:
            test_data.append("- **Verification codes:** Valid and expired codes for testing. Blocked — code format and values not specified.")
        if needs_email:
            test_data.append("- **Email addresses:** Valid and invalid email addresses for testing. Blocked — specific email values not specified.")
        if needs_password:
            test_data.append("- **Password samples:** Valid and invalid passwords for testing. Blocked — password values and policy not specified.")

    if not test_data:
        test_data.append("- **Test data requirements:** Cannot be determined — no acceptance criteria or business rules specify data requirements.")

    S.extend(test_data)
    S.append("")

    # ── 8. Required Environment Dependencies ──
    S.extend(["## 8. Required Environment Dependencies", ""])    # ── 8. Required Environment Dependencies ──
    env_deps = []
    if not env_enabled:
        env_deps.append("- **Test environment:** At least one environment (dev or staging) must be enabled in the project adapter.")
    else:
        env_deps.append(f"- **Test environment:** {', '.join(k for k, v in env.items() if v)} environment(s) enabled in project adapter.")

    if app.get("web"):
        env_deps.append("- **Application URL:** Base URL for the web application must be known.")
    if app.get("api"):
        env_deps.append("- **API base URL:** Base URL for the API must be known.")

    if safety.get("production_execution"):
        env_deps.append("- **Production safety:** Production execution is enabled — explicit authorization required for any production operation.")

    if not env_deps:
        env_deps.append("- **Environment dependencies:** Cannot be determined from project adapter.")

    S.extend(env_deps)
    S.append("")

    # ── 9. Confirmed Requirements ──
    S.extend(["## 9. Confirmed Requirements", ""])

    confirmed = []
    if user_story:
        confirmed.append(f"- {user_story}")
    if ac_items:
        for ac in ac_items:
            confirmed.append(f"- {ac['heading']}: {NL.join(ac['body']).strip()}")

    S.extend(confirmed if confirmed else ["- No confirmed requirements found in intake."])
    S.append("")

    # ── 10. Assumptions ──
    S.extend([
        "## 10. Assumptions",
        "",
        "- The feature is tested at the level appropriate to its interface (UI, API, or both) as determined by the project adapter and clarification.",
        "- Validation errors are displayed to the user in some observable form.",
        "- The project adapter is accurate and current.",
        "",
    ])

    # ── 11. Unknowns ──
    S.extend(["## 11. Unknowns", ""])

    unknowns = []
    if not ac_items:
        unknowns.append("- Acceptance criteria — not found in intake")
    if not env_enabled:
        unknowns.append("- Test environment — not enabled in project adapter")
    if app.get("web") and not any("url" in u.lower() for u in unknowns):
        unknowns.append("- Application URL / base URL")
    if api.get("rest") and not any("endpoint" in u.lower() for u in unknowns):
        unknowns.append("- API endpoints and contracts")

    # Add unknowns from grill
    grill_unknowns_text = grill_sections.get("Unknowns", "")
    if grill_unknowns_text:
        for line in grill_unknowns_text.splitlines():
            if line.strip().startswith("- "):
                unknowns.append(line.strip()[2:])

    S.extend(unknowns if unknowns else ["- No significant unknowns identified."])
    S.append("")

    # ── 12. Items Blocked Pending Clarification ──
    S.extend(["## 12. Items Blocked Pending Clarification", "", "| Item | Blocked by |", "|------|------------|"])

    blocked = []

    if any("Ambiguity" in line for line in extract_items(grill_sections.get("Ambiguities", ""))):
        blocked.append("| Ambiguities in requirement | Must be clarified before specification |")

    if not env_enabled:
        blocked.append("| Test environment targeting | No environments enabled in project adapter |")

    if api.get("rest") and not any("endpoint" in b.lower() for b in blocked):
        blocked.append("| API integration tests | API endpoints not specified |")

    if not blocked:
        blocked.append("| No items blocked | — |")

    S.extend(blocked)
    S.append("")

    # Footer
    S.extend([
        "---",
        "",
        f"*QA Specification performed by qa-run runtime. Specification is grounded in story-intake.md, grill/output.md, analysis/output.md, risk/output.md, architecture/output.md, discovery/output.md, and project.yaml only. No expected outcomes were invented. Blocked items are clearly identified.*",
    ])

    content = NL.join(S)
    art = write_stage_artifact(story_id, "specification/output.md", content)
    return "completed", [art]


# ── Stage 8: Test Design ───────────────────────────────────────────────────


def _execute_test_design(stage_name, story_id, story_source, project_config,
                         project_name, project_dir, stage_status):
    """Stage 8: Test Design — design test scenarios from specification.

    Inputs: specification/output.md, grill/output.md, architecture/output.md,
            discovery/output.md, project.yaml
    Outputs: shared-state/<story-id>/test-design/output.md
    Side effects: none
    """
    try:
        spec_text = load_stage_artifact(story_id, "specification/output.md")
        grill_text = load_stage_artifact(story_id, "grill/output.md")
        arch_text = load_stage_artifact(story_id, "architecture/output.md")
        discovery_text = load_stage_artifact(story_id, "discovery/output.md")
        intake_text = load_stage_artifact(story_id, "story-intake.md")
    except FileNotFoundError as e:
        return "blocked", [f"Missing input: {e}"]

    # Parse all inputs
    spec_sections = parse_markdown_sections(spec_text)
    grill_sections = parse_markdown_sections(grill_text)
    intake_sections = parse_markdown_sections(intake_text)

    # Extract story identity
    story_title = intake_sections.get("Story Title", intake_sections.get("Title", story_id))
    user_story = intake_sections.get("User Story", "").strip()
    NL = "\n"

    # Parse acceptance criteria
    ac_text = intake_sections.get("Acceptance Criteria", "").strip()
    ac_items = []
    if ac_text:
        for line in ac_text.splitlines():
            if line.startswith("### "):
                current = {"heading": line[4:].strip(), "body": []}
                ac_items.append(current)
            elif ac_items and current["heading"]:
                ac_items[-1]["body"].append(line)

    # Parse specification sections
    spec_functional_text = spec_sections.get("Functional Coverage", "")
    spec_negative_text = spec_sections.get("Negative Coverage", "")
    spec_boundary_text = spec_sections.get("Boundary Coverage", "")

    # Parse grill sections
    grill_negative_text = grill_sections.get("Negative Scenarios", "")
    grill_edge_text = grill_sections.get("Edge Cases", "")

    # Project adapter
    app = project_config.get("application", {})
    api = project_config.get("api", {})
    env = project_config.get("environments", {})
    safety = project_config.get("safety", {})
    env_enabled = any(env.get(k) for k in ("dev", "staging", "production"))

    D = []

    # ── Header ──
    D.extend([
        f"# Test Design — {story_id}",
        "",
        f"**Project:** {project_name}",
        "**Source inputs:** specification/output.md, grill/output.md, architecture/output.md, discovery/output.md, project.yaml",
        f"**Test design timestamp:** {now_iso()}",
        "",
        "---",
        "",
        "## 1. Requirement under Design",
        "",
    ])

    D.append(user_story or f"(No user story found for {story_id})")
    D.append("")

    # ── 2. Scenario List ──
    D.extend(["## 2. Scenario List", ""])

    scenarios = []
    tid = 0

    def next_id():
        nonlocal tid
        tid += 1
        return f"TC-{tid:02d}"

    # Generate happy-path scenarios from ACs
    if ac_items:
        for ac in ac_items:
            heading = ac["heading"]
            body = NL.join(ac["body"]).strip()
            sid = next_id()

            # Determine test level
            if any(w in body.lower() for w in ["clicks", "enters", "fill", "type", "form", "field", "button", "page", "navigate", "redirect", "display", "show"]):
                level = "E2E"
                fw = "Playwright"
            elif any(w in body.lower() for w in ["api", "endpoint", "request", "response", "status code", "http", "post", "get", "put", "delete"]):
                level = "API"
                fw = "HTTP client"
            elif any(w in body.lower() for w in ["database", "stored", "query", "table", "row", "record"]):
                level = "Database"
                fw = "Database client"
            else:
                level = "E2E"
                fw = "Playwright"

            auto = "Yes" if level in ("E2E", "API", "Database") else "Manual"
            manual = "No" if auto == "Yes" else "Yes — requires human judgment"

            # Test data
            td = []
            if "registered" in body.lower() or "exists" in body.lower() or "pre-existing" in body.lower():
                td.append("Precondition entity")
            if "valid" in body.lower():
                td.append("Valid input data")
            if "invalid" in body.lower():
                td.append("Invalid input data")

            # Environment
            env_dep = "Test environment" if env_enabled else "Test environment (not available)"

            # Notes
            notes = []
            if not env_enabled:
                notes.append("Blocked — no test environment enabled")
            if "error" in body.lower() and "not specified" in body.lower():
                notes.append("Blocked — error message text not defined")
            if any(w in body.lower() for w in ["redirect", "navigate", "Dashboard"]):
                notes.append("Blocked — destination not defined")

            scenarios.append((
                sid, heading, body[:100] + ("..." if len(body) > 100 else ""),
                heading, level, f"Automated ({fw})" if auto == "Yes" else "Manual",
                manual, "; ".join(td) if td else "None specified",
                env_dep, "; ".join(notes) if notes else "None"
            ))

    # Generate negative scenarios from grill
    if grill_negative_text:
        for line in grill_negative_text.splitlines():
            if line.strip().startswith("- **") and ":**" in line:
                sid = next_id()
                name = line.split(":**", 1)[0].replace("- **", "").strip()
                rest = line.split(":**", 1)[1]

                expected = ""
                if "Expected:" in rest:
                    expected = rest.split("Expected:", 1)[1].strip()
                    if ".**" in expected:
                        expected = expected.split(".**")[0] + ".**"

                desc = expected if expected else rest.strip()[:100] + ("..." if len(rest.strip()) > 100 else "")

                scenarios.append((
                    sid, name, desc,
                    "Grill negative scenario", "E2E", "Automated (Playwright)",
                    "No", "Negative test data",
                    "Test environment" if env_enabled else "Test environment (not available)",
                    "Behavior not specified in requirement" if "Not specified" in line else "None"
                ))

    # Generate edge case scenarios from grill
    if grill_edge_text:
        for line in grill_edge_text.splitlines():
            if line.strip().startswith("- **") and ":**" in line:
                sid = next_id()
                name = line.split(":**", 1)[0].replace("- **", "").strip()
                rest = line.split(":**", 1)[1]

                desc = rest.strip()[:100] + ("..." if len(rest.strip()) > 100 else "")

                scenarios.append((
                    sid, name, desc,
                    "Grill edge case", "E2E / Unit", "Automated (Playwright / Unit test)",
                    "No", "Edge case input data",
                    "Test environment or unit test framework",
                    "Not specified in story" if ("Not specified" in line or "Not mentioned" in line) else "None"
                ))

    # Write scenario table
    D.extend([
        "| ID | Name | Description | Linked Spec | Test Level | Automation Candidate | Manual Validation Required | Required Test Data | Required Environment Dependencies | Notes |",
        "|----|------|-------------|-------------|------------|---------------------|---------------------------|-------------------|--------------------------------|-------|",
    ])

    for s in scenarios:
        D.append(f"| {s[0]} | {s[1]} | {s[2]} | {s[3]} | {s[4]} | {s[5]} | {s[6]} | {s[7]} | {s[8]} | {s[9]} |")

    D.append("")

    # ── 3. Test-Level Rationale Summary ──
    D.extend(["## 3. Test-Level Rationale Summary", ""])

    rationale = []
    if any(s[4] == "E2E" for s in scenarios):
        rationale.append("- **E2E:** Chosen for scenarios involving user interactions with a UI (clicks, form inputs, navigation). Appropriate when the requirement specifies user-visible behavior.")
    if any(s[4] == "API" for s in scenarios):
        rationale.append("- **API:** Chosen for scenarios validating API contracts, request/response behavior, and status codes. Prefer API level over UI when the same risk can be covered at the API layer.")
    if any(s[4] == "Database" for s in scenarios):
        rationale.append("- **Database:** Chosen for scenarios validating data integrity, state changes, and storage behavior.")
    if any(s[4] == "E2E / Unit" for s in scenarios):
        rationale.append("- **E2E / Unit:** Edge cases and boundary conditions may be covered at either level depending on what is more efficient and reliable.")
    if not rationale:
        rationale.append("- No test-level assignments were made — insufficient information to determine appropriate levels.")

    D.extend(rationale)
    D.append("")

    # ── 4. Automation Candidates ──
    D.extend([
        "## 4. Automation Candidates",
        "",
        "| Scenario ID | Automation | Framework | Notes |",
        "|-------------|-----------|-----------|-------|",
    ])

    for s in scenarios:
        auto_status = "Yes" if "Automated" in s[5] else "No"
        fw = s[5].split("(")[-1].rstrip(")") if "(" in s[5] else "—"
        notes = s[9] if s[9] != "None" else "—"
        D.append(f"| {s[0]} | {auto_status} | {fw} | {notes} |")

    D.append("")

    # ── 5. Manual-Validation Scenarios ──
    D.extend(["## 5. Manual-Validation Scenarios", ""])
    manual_scenarios = [s for s in scenarios if "Yes" in s[6] and "No" not in s[6]]
    if manual_scenarios:
        for s in manual_scenarios:
            D.append(f"- **{s[0]} ({s[1]}):** {s[2]}")
    else:
        D.append("_(No manual-validation scenarios identified.)_")
    D.append("")

    # ── 6. Scenarios Blocked on Missing Data or Environment ──
    D.extend([
        "## 6. Scenarios Blocked on Missing Data or Environment",
        "",
        "| Scenario ID | Blocked Reason |",
        "|-------------|----------------|",
    ])

    blocked_scenarios = [s for s in scenarios if "Blocked" in s[9] or "not available" in s[9]]
    if blocked_scenarios:
        for s in blocked_scenarios:
            D.append(f"| {s[0]} | {s[9]} |")
    else:
        D.append("| None | No scenarios blocked |")
    D.append("")

    # ── 7. Out-of-Scope Scenarios ──
    D.extend(["## 7. Out-of-Scope Scenarios", ""])

    out_of_scope = []
    perf_enabled = project_config.get("performance", {}).get("enabled", False)
    sec_enabled = project_config.get("security", {}).get("enabled", False)

    if not perf_enabled:
        out_of_scope.append("- **Performance testing:** Not in scope — performance testing is not enabled in the project adapter.")
    if not sec_enabled:
        out_of_scope.append("- **Security penetration testing:** Not in scope — security testing is not enabled in the project adapter.")

    if out_of_scope:
        D.extend(out_of_scope)
    else:
        D.append("_(No out-of-scope items identified.)_")
    D.append("")

    # ── 8. Assumptions ──
    D.extend([
        "## 8. Assumptions",
        "",
        f"- The {story_title} feature is tested at the level appropriate to its interface (UI, API, or both) as determined by the project adapter and clarification.",
        "- The acceptance criteria in the intake represent the complete scope for this feature.",
        "- The project adapter is accurate and current.",
        "",
    ])

    # ── 9. Unknowns ──
    D.extend(["## 9. Unknowns", ""])

    unknowns = []
    if not env_enabled:
        unknowns.append("- Test environment availability")
    if app.get("web") and not any("url" in u.lower() for u in unknowns):
        unknowns.append("- Application URL / base URL")
    if api.get("rest"):
        unknowns.append("- API endpoints and contracts")

    grill_unknowns_text = grill_sections.get("Unknowns", "")
    if grill_unknowns_text:
        for line in grill_unknowns_text.splitlines():
            if line.strip().startswith("- "):
                u = line.strip()[2:]
                if u not in unknowns:
                    unknowns.append(u)

    D.extend(unknowns if unknowns else ["- No significant unknowns identified."])
    D.append("")

    # Footer
    D.extend([
        "---",
        "",
        f"*Test design performed by qa-run runtime. Design is grounded in specification/output.md, grill/output.md, architecture/output.md, discovery/output.md, and project.yaml only. No selectors, endpoints, credentials, or data values were invented. Scenarios blocked on missing data or environment are clearly identified.*",
    ])

    content = NL.join(D)
    art = write_stage_artifact(story_id, "test-design/output.md", content)
    return "completed", [art]


# ── Stage 9: Specialist Delegation ─────────────────────────────────────────


def _execute_delegation(stage_name, story_id, story_source, project_config,
                        project_name, project_dir, stage_status):
    """Stage 9: Specialist Delegation — assign scenarios to specialist agents.

    Inputs: test-design/output.md, architecture/output.md, discovery/output.md,
            project.yaml, skill-selection/report.md
    Outputs: shared-state/<story-id>/delegation/output.md
    Side effects: loads specialist agents from adapters/specialists.py
    """
    try:
        design_text = load_stage_artifact(story_id, "test-design/output.md")
        arch_text = load_stage_artifact(story_id, "architecture/output.md")
        discovery_text = load_stage_artifact(story_id, "discovery/output.md")
    except FileNotFoundError as e:
        return "blocked", [f"Missing input: {e}"]

    # ── Dynamic Skill Selection ──────────────────────────────────────────────
    target = None
    capabilities = {}
    adapter = None
    if ADAPTER_AVAILABLE:
        try:
            adapter = create_adapter(project_config, project_name, project_dir)
            target = adapter.get_target_repository_path()
            if target:
                capabilities = adapter.detect_capabilities()
        except Exception:
            pass

    story_text = ""
    try:
        story_text = load_stage_artifact(story_id, "story-intake.md")
    except FileNotFoundError:
        pass

    skill_selection = {"selected": [], "rejected": [], "rationale": {}}
    skill_report = ""
    if SKILL_SELECTOR_AVAILABLE and story_text:
        sel_result = select_and_report(story_text, project_config, capabilities)
        skill_selection = sel_result["selection"]
        skill_report = sel_result["report"]

    # ── Specialist Agents ─────────────────────────────────────────────────────
    specialist_map = {}
    if SPECIALISTS_AVAILABLE and target:
        if "playwright" in skill_selection.get("selected", []):
            specialist_map["playwright"] = PlaywrightAgent(story_id, project_config, target, adapter)
        if "api" in skill_selection.get("selected", []):
            specialist_map["api"] = APIAgent(story_id, project_config, target, adapter)

    # Parse test scenarios from test-design/output.md
    design_text = load_stage_artifact(story_id, "test-design/output.md")
    scenarios = []
    for line in design_text.splitlines():
        if line.startswith("| TC-") or line.startswith("| SC-"):
            parts = [p.strip() for p in line.split("|")]
            if len(parts) >= 6:
                scenarios.append({
                    "id": parts[1],
                    "name": parts[2],
                    "desc": parts[3],
                    "level": parts[4],
                    "automation": parts[5],
                })

    # Assign scenarios to specialists by test level
    assignments = {}
    for s in scenarios:
        level = s.get("level", "")
        if "E2E" in level or "UI" in level or "Web" in level:
            assignments.setdefault("playwright", []).append(s)
        elif "API" in level or "Service" in level:
            assignments.setdefault("api", []).append(s)
        else:
            if "playwright" in specialist_map:
                assignments.setdefault("playwright", []).append(s)

    # ── Delegation Output ─────────────────────────────────────────────────────
    deleg_lines = [
        f"# Specialist Delegation — {story_id}",
        "",
        f"**Project:** {project_name}",
        "**Source inputs:** test-design/output.md, architecture/output.md, discovery/output.md, project.yaml, skill-selection/report.md",
        f"**Delegation timestamp:** {now_iso()}",
        "",
        "---",
        "",
        "## 1. Dynamic Skill Selection",
        "",
    ]

    if skill_report:
        deleg_lines.append(skill_report)
    else:
        deleg_lines.append("_(Skill selection not available.)_")
    deleg_lines.append("")

    deleg_lines.extend([
        "## 2. Available Specialist Agents",
        "",
    ])

    if specialist_map:
        for sk, agent in specialist_map.items():
            can_exec = agent.can_execute()
            status_text = "AVAILABLE" if can_exec else "NOT READY"
            deleg_lines.append(f"- **{agent.name}:** {status_text} — target: {target}")
    else:
        deleg_lines.append("_(No specialist agents loaded.)_")
    deleg_lines.append("")

    deleg_lines.extend([
        "## 3. Delegation Records",
        "",
        "| Scenario ID | Scenario Name | Assigned Specialist | Status | Reason |",
        "|-------------|---------------|---------------------|--------|--------|",
    ])

    for s in scenarios:
        sid = s.get("id", "")
        sname = s.get("name", "")
        assigned = "None"
        status = "Blocked"
        reason = "No specialist available"

        for sk, slist in assignments.items():
            if s in slist:
                if SKILL_SELECTOR_AVAILABLE:
                    assigned = SKILLS.get(sk, {}).get("name", sk)
                else:
                    assigned = sk
                agent = specialist_map.get(sk)
                if agent and agent.can_execute():
                    status = "Ready"
                    reason = "Agent available and can execute"
                elif agent:
                    status = "Blocked"
                    reason = f"{agent.name} cannot execute (environment not ready)"
                else:
                    status = "Blocked"
                    reason = "Agent not loaded"
                break

        deleg_lines.append(f"| {sid} | {sname} | {assigned} | {status} | {reason} |")

    deleg_lines.extend([
        "",
        "## 4. Environment and Safety Gate Checks",
        "",
        "| Check | Result |",
        "|-------|--------|",
    ])

    safety = project_config.get("safety", {})
    deleg_lines.append(f"| Production execution safety gate | {'PASSED' if safety.get('production_execution') else 'Not applicable — disabled (safety.production_execution=false)'} |")
    deleg_lines.append(f"| Real payments safety gate | {'WARNING — real payments possible' if safety.get('real_payments') else 'Not applicable — disabled (safety.real_payments=false)'} |")
    deleg_lines.append(f"| Destructive database operations safety gate | {'WARNING' if safety.get('destructive_database_operations') else 'Not applicable — disabled (safety.destructive_database_operations=false)'} |")

    env = project_config.get("environments", {})
    env_ok = any(env.values())
    deleg_lines.append(f"| Test environment available | {'Yes' if env_ok else 'No — no environments enabled'} |")
    deleg_lines.append(f"| Application under test available | {'Yes — ' + str(target) if target else 'No — no target repository'} |")
    ready = sum(1 for a in specialist_map.values() if a.can_execute())
    deleg_lines.append(f"| Specialist agents ready | {ready} of {len(specialist_map)} |")

    deleg_lines.extend([
        "",
        "## 5. Blocked Delegations Summary",
        "",
    ])

    blocked_found = False
    for sk, slist in assignments.items():
        agent = specialist_map.get(sk)
        if agent and not agent.can_execute():
            for s in slist:
                deleg_lines.append(f"- **{s.get('id')} ({s.get('name')}):** Blocked — {agent.name} not ready.")
                blocked_found = True

    if not blocked_found:
        deleg_lines.append("_(No blocked delegations — all specialists ready.)_")

    deleg_lines.extend([
        "",
        "---",
        "",
        f"*Specialist delegation performed by qa-run runtime. Skill selection is dynamic based on story content, target capability map, and project.yaml. Specialist agents loaded from adapters/specialists.py.*",
    ])

    content = "\n".join(deleg_lines)
    art = write_stage_artifact(story_id, "delegation/output.md", content)

    # Determine delegation status:
    # - If no scenarios exist, delegation has nothing to do → completed
    # - If specialists are loaded (specialist_map non-empty), delegation did its job → completed
    # - If no specialists loaded AND no target → blocked (nothing to delegate to)
    # - If specialists loaded but none can execute → completed (execution will handle the block)
    if not scenarios:
        return "completed", [art]
    if not specialist_map and not target:
        return "blocked", [art]
    return "completed", [art]


