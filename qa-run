        return "skipped", [art1, art2, art3, art4]

    # Process failures and blockers
    fa_issue_count = 0
    classifications = []
    failure_details = []
    unknowns = []

    # Classify execution blocker
    if exec_blocked:
        fa_issue_count += 1
        issue_id = f"FA-{fa_issue_count:03d}"

        # Classify the blocker
        blocker_classification = "Environment issue"
        blocker_root_cause = "Unknown"
        blocker_confidence = "Medium"

        reason_lower = exec_blocker_reason.lower()
        if "no target" in reason_lower or "no target repository" in reason_lower:
            blocker_classification = "Configuration failure"
            blocker_root_cause = "Confirmed"
            blocker_confidence = "High"
        elif "no specialist" in reason_lower or "no specialist agents" in reason_lower:
            blocker_classification = "Dependency failure"
            blocker_root_cause = "Confirmed"
            blocker_confidence = "High"
        elif "spec generation blocked" in reason_lower or "base_url" in reason_lower:
            blocker_classification = "Environment issue"
            blocker_root_cause = "Confirmed"
            blocker_confidence = "High"
        elif "environment" in reason_lower:
            blocker_classification = "Environment issue"
            blocker_root_cause = "Probable"
            blocker_confidence = "Medium"

        classifications.append({
            "issue_id": issue_id,
            "classification": blocker_classification,
            "root_cause": blocker_root_cause,
            "confidence": blocker_confidence,
        })

        failure_details.append({
            "issue_id": issue_id,
            "source_stage": "Test Execution",
            "failure_type": "environment_blocker",
            "what_failed": "Test execution could not proceed",
            "expected": "Tests should execute against the configured target environment",
            "actual": f"Execution blocked: {exec_blocker_reason}",
