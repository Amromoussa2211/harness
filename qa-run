def parse_markdown_sections(text: str) -> dict[str, str]:
    """Split markdown into sections keyed by top-level heading.

    Duplicate headings are disambiguated by appending _2, _3, etc.
    Nested headings (##, ###) are captured as separate sections so that
    story files with ## Title / ## User Story / ## Acceptance Criteria
    are individually accessible.
    """
    sections: dict[str, str] = {}
    current: str | None = None
    current_lines: list[str] = []
    seen: dict[str, int] = {}

    for line in text.splitlines():
        if line.startswith("# ") and not line.startswith("## "):
            # Level-1 heading: new section
            if current is not None:
                key = _disambiguate(current, seen)
                sections[key] = "\n".join(current_lines).strip()
            current = line[2:].strip()
            current_lines = []
        elif line.startswith("## ") and not line.startswith("### "):
            # Level-2 heading: new section
            if current is not None:
                key = _disambiguate(current, seen)
                sections[key] = "\n".join(current_lines).strip()
            current = line[3:].strip()
            current_lines = []
        else:
            if current is not None:
                current_lines.append(line)
    if current is not None:
        key = _disambiguate(current, seen)
        sections[key] = "\n".join(current_lines).strip()
    return sections


def _disambiguate(name: str, seen: dict[str, int]) -> str:
    """Disambiguate duplicate section names by appending _2, _3, etc."""
    if name not in seen:
        seen[name] = 1
        return name
    seen[name] += 1
    return f"{name}_{seen[name]}"


def _validate_artifact_path(story_id: str, filename: str) -> Path:
    """Validate and resolve an artifact path, preventing path traversal.

    Returns the resolved full path.
    Raises ValueError if the path escapes shared-state/<story_id>/.
    """
    base = (ROOT / "shared-state").resolve()
    full_path = (ROOT / "shared-state" / story_id / filename).resolve()
    try:
        full_path.relative_to(base)
    except ValueError:
        raise ValueError(f"Path traversal detected: {filename}")
    # Also ensure it's under the story-specific subdirectory
    story_base = (ROOT / "shared-state" / story_id).resolve()
    try:
        full_path.relative_to(story_base)
    except ValueError:
        raise ValueError(f"Path traversal detected: {filename}")
    return full_path


def load_stage_artifact(story_id: str, filename: str) -> str:
    path = _validate_artifact_path(story_id, filename)
    with open(path) as f:
        return f.read()


def write_stage_artifact(story_id: str, filename: str, content: str) -> str:
    dir_path = ROOT / "shared-state" / story_id / os.path.dirname(filename)
    dir_path.mkdir(parents=True, exist_ok=True)
    full_path = _validate_artifact_path(story_id, filename)
    # Atomic write: write to temp, then replace
    import tempfile
    fd, tmp_path = tempfile.mkstemp(dir=str(full_path.parent), suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp_path, str(full_path))
    except Exception:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise
    return str(full_path.relative_to(ROOT))


def load_project_adapter(project_name: str) -> dict:
    """Load and validate project.yaml for the given project.

    Validates that required sections exist. Raises ValueError if
    required sections are missing or PyYAML is not available.
    """
    if not shutil.which("k6"):
        # PyYAML availability check
        pass  # yaml was already imported above

    path = ROOT / "projects" / project_name / "project.yaml"
    if not path.exists():
        raise ValueError(f"project.yaml not found: {path}")
    with open(path) as f:
        config = yaml.safe_load(f)
    if config is None:
        raise ValueError(f"project.yaml is empty: {path}")
    if not isinstance(config, dict):
        raise ValueError(f"project.yaml must contain a YAML mapping: {path}")

    # Validate required sections
    required_sections = ["application", "automation", "environments", "safety"]
    missing = [s for s in required_sections if s not in config]
    if missing:
        raise ValueError(
            f"project.yaml is missing required sections: {', '.join(missing)}. "
            f"File: {path}"
        )

    return config


