def build_fresh_status(stage_order: list[str], story_id: str) -> dict:
    stages = {}
    for name in stage_order:
        stages[name] = {
            "status": "pending",
            "started_at": None,
            "completed_at": None,
            "blocked_reason": None,
            "failed_reason": None,
            "skip_reason": None,
            "artifacts": [],
            "notes": "",
        }
    # Add AI-enhanced stage slots (always present for --mode ai support)
    ai_stage_names = [
        "ai-analysis", "ai-grill", "ai-risk", "ai-architecture",
        "ai-specification", "ai-test-design", "ai-failure-analysis", "ai-review",
    ]
    for name in ai_stage_names:
        if name not in stages:
            stages[name] = {
                "status": "pending",
                "started_at": None,
                "completed_at": None,
                "blocked_reason": None,
                "failed_reason": None,
                "skip_reason": None,
                "artifacts": [],
                "notes": "",
            }
    stages["story-intake"]["status"] = "in_progress"
    return {
        "run_id": story_id_safe(story_id),
        "overall_status": "running",
        "started_at": now_iso(),
        "created_at": now_iso(),
        "stages": stages,
        "project": "",
        "story": "",
        "workflow_version": STAGE_STATUS_VERSION,
    }


def load_stage_status(story_id: str) -> dict | None:
    path = ROOT / "shared-state" / story_id / "stage-status.json"
    if not path.exists():
        return None
    with open(path) as f:
        data = json.load(f)
    # Enforce version compatibility
    if data.get("workflow_version") != STAGE_STATUS_VERSION:
        print(
            f"Warning: stage-status.json workflow_version '{data.get('workflow_version')}' "
            f"does not match expected '{STAGE_STATUS_VERSION}'. "
            f"Consider resetting shared-state/{story_id}/ if issues occur.",
            file=sys.stderr,
        )
    return data


def save_stage_status(story_id: str, status: dict) -> None:
    dir_path = ROOT / "shared-state" / story_id
    dir_path.mkdir(parents=True, exist_ok=True)
    path = dir_path / "stage-status.json"
    # Atomic write
    import tempfile
    fd, tmp_path = tempfile.mkstemp(dir=str(path.parent), suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(status, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp_path, str(path))
    except Exception:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise


def calculate_overall_status(stages: dict) -> str:
    """Calculate overall workflow status from individual stage statuses.

    Precedence (highest to lowest):
        failed > blocked > running > partial > completed
    """
    statuses = {s["status"] for s in stages.values()}
    if "failed" in statuses:
        return "failed"
    if "blocked" in statuses:
        return "blocked"
    if "in_progress" in statuses:
        return "running"
    if statuses == {"completed"} or (statuses <= {"completed", "skipped"} and all(
        s["status"] == "skipped" or s["status"] == "completed" for s in stages.values()
    )):
        return "completed"
    if any(s["status"] in ("completed", "skipped") for s in stages.values()):
        return "partial"
    return "running"


def find_first_pending_stage(stage_order: list[str], stages: dict) -> str | None:
    """Find the first stage that needs to run.

    Rules:
    - completed stages are skipped (already done)
    - skipped stages WITH a skip_reason are treated as resolved
    - skipped stages WITHOUT a skip_reason are flagged (return them)
    - failed/blocked stages are returned (need attention)
    - in_progress stages are returned (need resume)
    """
    for name in stage_order:
        st = stages[name]["status"]
        if st == "completed":
            continue
        if st == "skipped":
            # If there's no skip_reason, this stage was silently skipped — flag it
            if not stages[name].get("skip_reason"):
                return name
            # Otherwise, it was intentionally skipped — treat as resolved
            continue
        if st == "blocked":
            # If a blocked_reason is recorded, the stage has been resolved as blocked.
            # Allow the workflow to continue past it (user can delete state to retry).
            if stages[name].get("blocked_reason"):
                continue
            # No reason recorded — flag it
            return name
        # pending, in_progress, failed — all need attention
        return name
    return None


