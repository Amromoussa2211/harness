def _execute_final_report(stage_name, story_id, story_source, project_config,
                          project_name, project_dir, stage_status):
    """Stage 14: Final QA Report — produce the consolidated final report.

    Inputs: all shared-state artifacts from all 14 stages + project.yaml
    Outputs: final-report.md
    Side effects: explicitly tracks missing artifacts; does not silently swallow them
    """
    missing_artifacts = []

    def _safe_load(path):
        try:
            return load_stage_artifact(story_id, path)
        except FileNotFoundError:
            missing_artifacts.append(path)
            return ""

    intake_text = _safe_load("story-intake.md")
    discovery_text = _safe_load("discovery/output.md")
    analysis_text = _safe_load("analysis/output.md")
    grill_text = _safe_load("grill/output.md")
    risk_text = _safe_load("risk/output.md")
    arch_text = _safe_load("architecture/output.md")
    spec_text = _safe_load("specification/output.md")
    design_text = _safe_load("test-design/output.md")
    deleg_text = _safe_load("delegation/output.md")
    exec_text = _safe_load("execution/run-report.md")
    fa_text = _safe_load("failure-analysis/classifications.md")
    review_text = _safe_load("review/review-report.md")
    evidence_text = _safe_load("evidence/consolidated.md")

    # Derive counts from actual artifacts
    scenario_count = design_text.count("| TC-") + design_text.count("| SC-")

    # Parse actual execution results from run-report.md
    exec_passed = 0
    exec_failed = 0
    exec_blocked = 0
    exec_total = 0
    exec_status = "Not executed"
    if exec_text:
        # Parse "Tests passed: N" and "Tests failed: N" and "Tests blocked: N"
        import re
        pass_m = re.search(r"\*\*Tests passed:\*\*\s*(\d+)", exec_text)
        fail_m = re.search(r"\*\*Tests failed:\*\*\s*(\d+)", exec_text)
        block_m = re.search(r"\*\*Tests blocked:\*\*\s*(\d+)", exec_text)
        if pass_m:
