# AI Provider Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# AI Provider (noop, openai, local)
AI_PROVIDER=noop

# Real model used when AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional: base URL for OpenAI-compatible API (used with AI_PROVIDER=openai)
# AI_BASE_URL=https://api.openai.com/v1

# Optional: local LLM server (used with AI_PROVIDER=local)
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=llama3
# LOCAL_LLM_API_KEY=
